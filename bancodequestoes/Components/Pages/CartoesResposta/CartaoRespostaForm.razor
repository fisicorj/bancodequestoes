@page "/cartoes-resposta/novo"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject CartaoRespostaService CartaoRespostaService
@inject ProvaService ProvaService
@inject CursoService CursoService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager

<PageTitle>Aplicar prova com cartão resposta</PageTitle>

<PageHeader Titulo="Aplicar prova com cartão resposta" Subtitulo="Gera um cartão com QR Code por aluno matriculado, pra imprimir, aplicar no papel e depois corrigir fotografando os cartões preenchidos. Só funciona com provas 100% múltipla escolha." />

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}

@if (carregando)
{
    <p><em>Carregando...</em></p>
}
else if (provas.Count == 0)
{
    <p><em>Cadastre uma prova antes.</em> <a href="provas/novo">Criar prova</a></p>
}
else if (turmas.Count == 0)
{
    <p><em>Cadastre uma turma antes.</em> <a href="turmas/novo">Criar turma</a></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="form-card">
                <EditForm Model="modelo" OnValidSubmit="SalvarAsync">
                    <div class="form-floating mb-3">
                        <InputSelect @bind-Value="modelo.ProvaId" id="ProvaId" class="form-select">
                            <option value="0">Selecione...</option>
                            @foreach (var p in provas)
                            {
                                <option value="@p.Id">@p.Titulo</option>
                            }
                        </InputSelect>
                        <label for="ProvaId">Prova (só múltipla escolha)</label>
                    </div>

                    <div class="form-floating mb-3">
                        <InputSelect @bind-Value="modelo.TurmaId" id="TurmaId" class="form-select">
                            <option value="0">Selecione...</option>
                            @foreach (var t in turmas)
                            {
                                <option value="@t.Id">@t.Rotulo</option>
                            }
                        </InputSelect>
                        <label for="TurmaId">Turma (um cartão por aluno matriculado nela)</label>
                    </div>

                    <button type="submit" class="btn btn-primary">Gerar cartões</button>
                    <a href="cartoes-resposta" class="btn btn-link">Cancelar</a>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "provaId")]
    private int? ProvaIdInicial { get; set; }

    private CartaoRespostaInput modelo = new();
    private List<Prova> provas = new();
    private List<Turma> turmas = new();
    private string? meuId;
    private string? erro;
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        meuId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        var resultado = await ProvaService.ListarAsync(new ProvaFiltro(), meuId, pagina: 1, tamanhoPagina: 1000);
        provas = resultado.Itens;
        turmas = await CursoService.ListarTodasTurmasAsync();

        if (ProvaIdInicial is int id)
        {
            modelo.ProvaId = id;
        }

        carregando = false;
    }

    private async Task SalvarAsync()
    {
        erro = null;

        try
        {
            var aplicacao = await CartaoRespostaService.CriarAsync(modelo, meuId);
            NavigationManager.NavigateTo($"cartoes-resposta/{aplicacao.Id}?msg={Uri.EscapeDataString("Cartões gerados — baixe o PDF pra imprimir e distribuir aos alunos.")}");
        }
        catch (OperacaoInvalidaException ex)
        {
            erro = ex.Message;
        }
    }
}
