@page "/cartoes-resposta"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CartaoRespostaService CartaoRespostaService
@inject IJSRuntime JS

<PageTitle>Cartão Resposta</PageTitle>

<PageHeader Titulo="Cartão Resposta" Subtitulo="Correção de provas impressas por foto do cartão resposta preenchido — múltipla escolha.">
    <Acao>
        <a class="btn btn-primary" href="cartoes-resposta/novo">+ Aplicar com cartão resposta</a>
    </Acao>
</PageHeader>

@if (sucesso is not null)
{
    <div class="alert alert-success">@sucesso</div>
}

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}

@if (aplicacoes is null)
{
    <p><em>Carregando...</em></p>
}
else if (aplicacoes.Count == 0)
{
    <p><em>Nenhuma aplicação de cartão resposta ainda.</em></p>
}
else
{
    <p class="text-muted small">
        Mostrando @((pagina - 1) * TamanhoPagina + 1)–@((pagina - 1) * TamanhoPagina + aplicacoes.Count) de @totalRegistros aplicação(ões).
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>Prova</th>
                <th>Turma</th>
                <th>Criada em</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in aplicacoes)
            {
                <tr>
                    <td>@a.Prova?.Titulo</td>
                    <td>@a.Turma?.Rotulo</td>
                    <td>@a.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-secondary" href="@($"cartoes-resposta/{a.Id}")">Abrir</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarExcluirAsync(a)">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Paginacao Pagina="pagina" TamanhoPagina="TamanhoPagina" TotalRegistros="totalRegistros" PaginaChanged="MudarPaginaAsync" />
}

@code {
    private List<CartaoRespostaAplicacao>? aplicacoes;
    private string? erro;
    private string? sucesso;

    private const int TamanhoPagina = 20;
    private int pagina = 1;
    private int totalRegistros;

    [SupplyParameterFromQuery(Name = "msg")]
    private string? Msg { get; set; }

    protected override async Task OnInitializedAsync()
    {
        sucesso = Msg;
        await CarregarAsync();
    }

    private async Task MudarPaginaAsync(int novaPagina)
    {
        pagina = novaPagina;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        var resultado = await CartaoRespostaService.ListarAsync(pagina, TamanhoPagina);
        aplicacoes = resultado.Itens;
        totalRegistros = resultado.Total;
    }

    private async Task ConfirmarExcluirAsync(CartaoRespostaAplicacao a)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Excluir a aplicação de \"{a.Prova?.Titulo}\" na turma \"{a.Turma?.Rotulo}\"? Essa ação não pode ser desfeita.");
        if (confirmado)
        {
            erro = null;
            sucesso = null;
            try
            {
                await CartaoRespostaService.ExcluirAsync(a);
                sucesso = "Aplicação excluída com sucesso.";
                await CarregarAsync();
            }
            catch (OperacaoInvalidaException ex)
            {
                erro = ex.Message;
            }
        }
    }
}
