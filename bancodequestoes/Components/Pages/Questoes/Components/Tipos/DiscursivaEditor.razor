@using BancoQuestoes.Exportacao
@inject SugestaoIaService SugestaoIa
<!--
    Editor do corpo específico de Discursiva (Etapa 3 — extraído de QuestaoForm.razor, idêntico ao original).

    Botão "Sugerir com IA" adicionado depois: mesmo padrão de ExplicacaoEditor/SugestaoIaCard (sugestão
    opcional, nunca aplicada sozinha — o professor clica em "Usar" pra copiar pro campo), mas aqui a IA
    propõe a resposta esperada do ZERO (nada foi escrito ainda), diferente de ExplicacaoEditor, que só
    EXPLICA uma resposta já definida — por isso a revisão importa ainda mais.

    IaHabilitada vem por parâmetro (calculado uma vez em QuestaoForm.OnInitializedAsync), não consultado
    aqui — mesmo motivo já documentado em ExplicacaoEditor/SugestaoIaCard (evita corrida de DbContext entre
    componentes-irmãos renderizados no mesmo passe).
-->
<div class="form-floating mb-3">
    <InputTextArea @bind-Value="Modelo.RespostaEsperada" id="RespostaEsperada" class="form-control" style="height: 80px;" placeholder="Resposta esperada" />
    <label for="RespostaEsperada">Resposta esperada</label>
</div>

@if (IaHabilitada)
{
    <div class="ia-assistente-box mb-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(carregando || string.IsNullOrWhiteSpace(Modelo.Enunciado))" @onclick="SugerirAsync">
                @if (carregando)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                else
                {
                    <i class="bi bi-stars me-1"></i>
                }
                Sugerir resposta esperada com IA
            </button>
            <span class="text-muted small">A partir do enunciado (modelo local) — é só um ponto de partida, revise e complete antes de usar.</span>
        </div>

        @if (string.IsNullOrWhiteSpace(Modelo.Enunciado))
        {
            <p class="text-muted small mb-0 mt-1">Escreva o enunciado antes de pedir a sugestão.</p>
        }

        @if (erro is not null)
        {
            <p class="text-danger small mb-0 mt-2">@erro</p>
        }

        @if (sugestao is not null)
        {
            <div class="mt-2">
                <div class="border rounded p-2 bg-white markdown-preview mb-2">@RenderizarPreview(sugestao)</div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Aplicar">Usar esta resposta</button>
            </div>
        }
    </div>
}

<div class="form-floating mb-3">
    <InputTextArea @bind-Value="Modelo.CriterioAvaliacao" id="CriterioAvaliacao" class="form-control" style="height: 80px;" placeholder="Critério de avaliação (opcional)" />
    <label for="CriterioAvaliacao">Critério de avaliação (opcional)</label>
</div>

@code {
    [Parameter, EditorRequired] public QuestaoInput Modelo { get; set; } = null!;
    [Parameter] public bool IaHabilitada { get; set; }

    private bool carregando;
    private string? erro;
    private string? sugestao;

    private static MarkupString RenderizarPreview(string markdown) => (MarkupString)MarkdownPreview.ParaHtml(markdown);

    private async Task SugerirAsync()
    {
        carregando = true;
        erro = null;
        sugestao = null;

        try
        {
            sugestao = await SugestaoIa.SugerirRespostaEsperadaDiscursivaAsync(Modelo.Enunciado);
            if (sugestao is null)
            {
                erro = "Não foi possível obter a sugestão agora — pode ser o Ollama fora do ar, ou o modelo ainda carregando/gerando (pode demorar mais na primeira vez). Tente de novo em instantes.";
            }
        }
        finally
        {
            carregando = false;
        }
    }

    private void Aplicar()
    {
        if (sugestao is not null)
        {
            Modelo.RespostaEsperada = sugestao;
        }
    }
}
