@page "/questoes"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using BancoQuestoes.Importacao
@using BancoQuestoes.Exportacao
@using BancoQuestoes.Components.Pages.Questoes.Components
@using BancoQuestoes.Components.Pages.Provas.Components
@inject QuestaoService QuestaoService
@inject QuestaoTagService QuestaoTagService
@inject SugestaoIaService SugestaoIa
@inject QuestaoQueryService QuestaoQueryService
@inject DisciplinaService DisciplinaService
@inject CursoService CursoService
@inject AreaCursoService AreaCursoService
@inject MatrizReferenciaService MatrizService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject ILogger<QuestaoList> Logger

<PageTitle>Questões</PageTitle>

<PageHeader Titulo="Questões" Subtitulo="Gerencie, encontre e reutilize suas questões.">
    <Acao>
        <a class="btn btn-primary" href="questoes/novo">+ Nova questão</a>
        <div class="dropdown-simples">
            <button type="button" class="btn btn-outline-secondary" @onclick="() => mostrarMaisAcoes = !mostrarMaisAcoes">
                Mais ações <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </button>
            @if (mostrarMaisAcoes)
            {
                <div class="dropdown-simples-menu">
                    @if (iaHabilitada)
                    {
                        <a class="dropdown-simples-item" href="questoes/gerar-ia"><i class="bi bi-stars" aria-hidden="true"></i> Criar com IA</a>
                    }
                    <a class="dropdown-simples-item" href="questoes/importar">Importar (Aiken/GIFT)</a>
                    <a class="dropdown-simples-item" href="questoes/importar-enade">Importar Prova ENADE</a>
                    <button type="button" class="dropdown-simples-item" disabled="@classificandoBloom" @onclick="ClassificarBloomAsync">
                        @if (classificandoBloom)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Classificar Bloom automaticamente
                    </button>
                    @if (iaHabilitada)
                    {
                        <div class="dropdown-simples-item form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="usarIaBloom" @bind="usarIaBloom" disabled="@classificandoBloom" />
                            <label class="form-check-label small" for="usarIaBloom">usar IA nas sem palavra-chave reconhecida</label>
                        </div>
                    }
                </div>
            }
        </div>
    </Acao>
</PageHeader>

@if (sucesso is not null)
{
    <div class="alert alert-success">@sucesso</div>
}

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}

<QuestaoFiltrosBar Filtro="filtro"
                   Disciplinas="disciplinas"
                   AssuntosDoFiltro="AssuntosDoFiltro"
                   Cursos="cursos"
                   AreasCurso="areasCurso"
                   MatrizesDoFiltroCurso="matrizesDoFiltroCurso"
                   ItensDoFiltroMatriz="itensDoFiltroMatriz"
                   TodasTags="todasTags"
                   OnFiltroAlterado="AplicarFiltroAsync"
                   OnMudarDisciplina="AoMudarDisciplinaAsync"
                   OnMudarCurso="AoMudarCursoFiltroAsync"
                   OnMudarMatriz="AoMudarMatrizFiltroAsync"
                   OnAlternarTag="AlternarFiltroTagAsync"
                   OnLimparFiltros="LimparFiltrosAsync" />

@if (questoes is null)
{
    <p><em>Carregando...</em></p>
}
else if (questoes.Count == 0 && !FiltroEstaAtivo)
{
    <div class="empty-state">
        <i class="bi bi-inbox empty-state-icon" aria-hidden="true"></i>
        <p class="empty-state-title">Seu banco de questões está vazio.</p>
        <p class="empty-state-text">Crie sua primeira questão ou importe questões.</p>
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-primary" href="questoes/novo">+ Criar questão</a>
            <a class="btn btn-outline-secondary" href="questoes/importar">Importar</a>
        </div>
    </div>
}
else if (questoes.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-filter-circle empty-state-icon" aria-hidden="true"></i>
        <p class="empty-state-title">Nenhuma questão encontrada.</p>
        <p class="empty-state-text">Tente remover alguns filtros.</p>
        <button type="button" class="btn btn-outline-secondary" @onclick="LimparFiltrosAsync">Limpar filtros</button>
    </div>
}
else
{
    <p class="text-muted small">
        Mostrando @((pagina - 1) * TamanhoPagina + 1)–@((pagina - 1) * TamanhoPagina + questoes.Count) de @totalRegistros questão(ões).
    </p>

    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="selecionarPagina" checked="@TodasNaPaginaSelecionadas" @onchange="AlternarSelecaoPagina" />
            <label class="form-check-label small" for="selecionarPagina">Selecionar todas nesta página</label>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(selecionadas.Count == 0)" @onclick="ExportarGiftAsync">
            Exportar selecionadas (GIFT)
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(selecionadas.Count == 0)" @onclick="ExportarAikenAsync">
            Exportar selecionadas (Aiken)
        </button>
        @if (selecionadas.Count > 0)
        {
            <span class="text-muted small">@selecionadas.Count selecionada(s)</span>
        }
    </div>

    <div class="d-flex flex-column gap-3">
        @foreach (var q in questoes)
        {
            <QuestaoCard Questao="q"
                         Selecionada="selecionadas.Contains(q.Id)"
                         Minha="q.CriadoPorId == meuId"
                         Usos="usosPorQuestao.GetValueOrDefault(q.Id)"
                         UltimoUso="ultimoUsoPorQuestao.GetValueOrDefault(q.Id)"
                         LimiarAltaExposicao="LimiarAltaExposicao"
                         OnToggleSelecao="marcado => AlternarSelecao(q.Id, marcado)"
                         OnDuplicar="() => DuplicarAsync(q)"
                         OnPreview="() => AbrirPreviewAsync(q.Id)"
                         OnAlternarAtiva="() => AlternarAtivaAsync(q)"
                         OnExcluir="() => ConfirmarExcluirAsync(q)" />
        }
    </div>

    <div class="mt-3">
        <Paginacao Pagina="pagina" TamanhoPagina="TamanhoPagina" TotalRegistros="totalRegistros" PaginaChanged="MudarPaginaAsync" />
    </div>
}

<QuestaoPreviewModal QuestaoAtual="questaoPreview"
                     JaSelecionada="false"
                     UsosDaQuestao="questaoPreview is null ? 0 : usosPorQuestao.GetValueOrDefault(questaoPreview.Id)"
                     OnFechar="FecharPreview"
                     Titulo="Prévia da questão"
                     MostrarAlinhamentoCurricular="true"
                     UltimoUso="questaoPreviewUltimoUso"
                     LimiarAltaExposicao="LimiarAltaExposicao"
                     FormatarDificuldade="false"
                     MostrarDisciplinaNoAssunto="true"
                     MostrarBotaoAdicionar="false" />

@code {
    private List<Questao>? questoes;
    private List<Disciplina> disciplinas = new();
    private List<Assunto> todosAssuntos = new();

    // Todos os filtros num objeto só; QuestaoFiltrosBar liga direto nos campos.
    private QuestaoFiltro filtro = new();
    private List<Tag> todasTags = new();
    private string? sucesso;
    private string? erro;

    // CursoId escopa o <select> de Matriz; MatrizReferenciaId escopa o de Item;
    // ItemMatrizId é quem filtra de fato.
    private List<Curso> cursos = new();
    private List<AreaCurso> areasCurso = new();
    private List<MatrizReferencia> matrizesDoFiltroCurso = new();
    private List<ItemMatrizReferencia> itensDoFiltroMatriz = new();

    private const int TamanhoPagina = 20;
    private int pagina = 1;
    private int totalRegistros;

    // Limiar fixo só pro alerta visual; o gerador usa peso decrescente por uso.
    private const int LimiarAltaExposicao = 10;

    private Dictionary<int, int> usosPorQuestao = new();
    private Dictionary<int, UltimoUsoInfo> ultimoUsoPorQuestao = new();
    private UltimoUsoInfo? questaoPreviewUltimoUso;
    private HashSet<int> selecionadas = new();
    private string? meuId;
    private int? minhaInstituicaoId;

    private Questao? questaoPreview;

    // Estado do menu "Mais ações" do cabeçalho (ver PageHeader) — puramente
    // visual, sem efeito em nenhuma regra de negócio.
    private bool mostrarMaisAcoes;

    [SupplyParameterFromQuery(Name = "msg")]
    private string? Msg { get; set; }

    // Lista de assuntos exibida no <select>, restrita à disciplina escolhida
    // (ou todas, se nenhuma disciplina estiver selecionada no filtro).
    private IEnumerable<Assunto> AssuntosDoFiltro => filtro.DisciplinaId == 0
        ? todosAssuntos
        : todosAssuntos.Where(a => a.DisciplinaId == filtro.DisciplinaId);

    private bool TodasNaPaginaSelecionadas => questoes is { Count: > 0 } && questoes.All(q => selecionadas.Contains(q.Id));

    // Distingue "banco vazio de verdade" (nenhum filtro, zero questões) de
    // "filtro não bateu com nada" — cada caso tem um empty state diferente.
    private bool FiltroEstaAtivo =>
        !string.IsNullOrWhiteSpace(filtro.Texto) ||
        filtro.DisciplinaId != 0 ||
        filtro.AssuntoId != 0 ||
        filtro.Tipo is not null ||
        filtro.Dificuldade is not null ||
        filtro.Visibilidade is not null ||
        filtro.Bloom is not null ||
        filtro.Origem is not null ||
        filtro.Ano is not null ||
        filtro.SecaoEnade is not null ||
        filtro.TagIds.Count > 0 ||
        filtro.MostrarInativas ||
        filtro.CursoId != 0 ||
        filtro.AreaCursoId != 0 ||
        filtro.MatrizReferenciaId != 0 ||
        filtro.ItemMatrizId != 0;

    protected override async Task OnInitializedAsync()
    {
        sucesso = Msg;
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        meuId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        minhaInstituicaoId = await QuestaoService.ObterInstituicaoDoUsuarioAsync(meuId);
        disciplinas = await DisciplinaService.ListarTodasAsync();
        todosAssuntos = await DisciplinaService.ListarTodosAssuntosAsync();
        todasTags = await QuestaoTagService.ListarTagsAsync();
        cursos = await CursoService.ListarTodosAsync();
        areasCurso = await AreaCursoService.ListarAtivasAsync();
        iaHabilitada = await SugestaoIa.HabilitadaAsync();
        await CarregarAsync();
    }

    // Trocar o curso invalida a matriz/item selecionados (podem ser de outro
    // curso), mesma lógica de AoMudarDisciplinaAsync abaixo pra Assunto.
    private async Task AoMudarCursoFiltroAsync()
    {
        filtro.MatrizReferenciaId = 0;
        filtro.ItemMatrizId = 0;
        itensDoFiltroMatriz = new();
        matrizesDoFiltroCurso = filtro.CursoId == 0
            ? new()
            : await MatrizService.ListarPorCursoAsync(filtro.CursoId);
        pagina = 1;
        await CarregarAsync();
    }

    // Trocar a matriz invalida o item selecionado (ele pode ser de outra
    // matriz).
    private async Task AoMudarMatrizFiltroAsync()
    {
        filtro.ItemMatrizId = 0;
        itensDoFiltroMatriz = filtro.MatrizReferenciaId == 0
            ? new()
            : await MatrizService.ListarItensAsync(filtro.MatrizReferenciaId);
        pagina = 1;
        await CarregarAsync();
    }

    private async Task AlternarFiltroTagAsync(int tagId)
    {
        if (!filtro.TagIds.Add(tagId))
        {
            filtro.TagIds.Remove(tagId);
        }
        pagina = 1;
        await CarregarAsync();
    }

    // Trocar a disciplina invalida o assunto selecionado (ele pode pertencer
    // a outra disciplina), então zera antes de recarregar.
    private async Task AoMudarDisciplinaAsync()
    {
        filtro.AssuntoId = 0;
        pagina = 1;
        await CarregarAsync();
    }

    // Qualquer mudança de filtro volta pra primeira página — senão o usuário pode
    // ficar "preso" numa página que não existe mais pro novo resultado filtrado.
    private async Task AplicarFiltroAsync()
    {
        pagina = 1;
        await CarregarAsync();
    }

    private async Task LimparFiltrosAsync()
    {
        filtro = new QuestaoFiltro();
        matrizesDoFiltroCurso = new();
        itensDoFiltroMatriz = new();
        pagina = 1;
        await CarregarAsync();
    }

    private async Task MudarPaginaAsync(int novaPagina)
    {
        pagina = novaPagina;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        var resultado = await QuestaoQueryService.ListarAsync(filtro, meuId, minhaInstituicaoId, pagina, TamanhoPagina);
        questoes = resultado.Itens;
        totalRegistros = resultado.Total;

        var idsNaPagina = questoes.Select(q => q.Id).ToList();
        (usosPorQuestao, ultimoUsoPorQuestao) = await QuestaoQueryService.ObterUsoAsync(idsNaPagina);
    }

    private void AlternarSelecao(int id, bool marcado)
    {
        if (marcado)
        {
            selecionadas.Add(id);
        }
        else
        {
            selecionadas.Remove(id);
        }
    }

    private void AlternarSelecaoPagina(ChangeEventArgs e)
    {
        if (questoes is null)
        {
            return;
        }

        var marcar = (bool)e.Value!;
        foreach (var q in questoes)
        {
            if (marcar)
            {
                selecionadas.Add(q.Id);
            }
            else
            {
                selecionadas.Remove(q.Id);
            }
        }
    }

    private async Task AlternarAtivaAsync(Questao q)
    {
        erro = null;
        try
        {
            await QuestaoService.AlternarAtivaAsync(q, meuId);
            await CarregarAsync();
        }
        catch (OperacaoInvalidaException ex)
        {
            erro = ex.Message;
        }
    }

    private async Task ConfirmarExcluirAsync(Questao q)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Excluir a questão \"{Truncar(q.Enunciado)}\"? Essa ação não pode ser desfeita.");
        if (confirmado)
        {
            await ExcluirAsync(q);
        }
    }

    private async Task ExcluirAsync(Questao q)
    {
        erro = null;
        sucesso = null;
        try
        {
            await QuestaoService.ExcluirAsync(q, meuId);
            sucesso = "Questão excluída com sucesso.";
            await CarregarAsync();
        }
        catch (OperacaoInvalidaException ex)
        {
            erro = ex.Message;
        }
    }

    // Preenche o Bloom só de quem está em branco, entre as minhas questões, por
    // heurística e, se marcado, IA (mais lenta, uma chamada por questão).
    private bool iaHabilitada;

    private bool usarIaBloom;
    private bool classificandoBloom;

    private async Task ClassificarBloomAsync()
    {
        erro = null;
        sucesso = null;
        classificandoBloom = true;

        try
        {
            var (classificadas, semSugestao) = await QuestaoService.ClassificarBloomAutomaticamenteAsync(meuId, usarIaBloom);

            sucesso = classificadas == 0
                ? "Nenhuma questão sua sem Bloom tinha sugestão pra dar."
                : $"{classificadas} questão(ões) classificada(s) por Bloom automaticamente." +
                    (semSugestao > 0 ? $" {semSugestao} continuaram sem sugestão clara — classifique manualmente." : "");

            await CarregarAsync();
        }
        finally
        {
            classificandoBloom = false;
        }
    }

    private async Task DuplicarAsync(Questao original)
    {
        erro = null;
        sucesso = null;
        try
        {
            await QuestaoService.DuplicarAsync(original.Id, meuId, minhaInstituicaoId);
            sucesso = "Questão duplicada com sucesso. Ajuste o que precisar na cópia.";
            await CarregarAsync();
        }
        catch (OperacaoInvalidaException ex)
        {
            erro = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Falha ao duplicar questão {QuestaoId}", original.Id);
            erro = "Não foi possível duplicar essa questão.";
        }
    }

    private Task ExportarGiftAsync() => ExportarAsync("gift");

    private Task ExportarAikenAsync() => ExportarAsync("aiken");

    private async Task ExportarAsync(string formato)
    {
        erro = null;
        sucesso = null;

        var completas = new List<Questao>();
        foreach (var id in selecionadas)
        {
            var q = await QuestaoService.CarregarVisivelAsync(id, meuId, minhaInstituicaoId);
            if (q is not null)
            {
                completas.Add(q);
            }
        }

        var (conteudo, ignoradas) = formato == "gift" ? GiftExporter.Gerar(completas) : AikenExporter.Gerar(completas);

        if (string.IsNullOrWhiteSpace(conteudo))
        {
            erro = "Nenhuma das questões selecionadas pôde ser exportada nesse formato.";
            return;
        }

        var extensao = formato == "gift" ? "gift.txt" : "aiken.txt";
        var nomeArquivo = $"questoes-{DateTime.Now:yyyyMMdd-HHmm}.{extensao}";
        await JS.InvokeVoidAsync("bqDownloadText", nomeArquivo, conteudo);

        if (ignoradas.Count > 0)
        {
            var amostra = string.Join("; ", ignoradas.Take(5));
            var resto = ignoradas.Count > 5 ? $" (e mais {ignoradas.Count - 5})" : "";
            erro = $"{ignoradas.Count} questão(ões) sem equivalente nesse formato foram ignoradas: {amostra}{resto}.";
        }
        else
        {
            sucesso = $"{completas.Count} questão(ões) exportada(s) com sucesso.";
        }
    }

    // Visão "de professor" (mostra a resposta certa), não a versão embaralhada do
    // PDF/DOCX; usa o QuestaoPreviewModal compartilhado com ProvaForm.razor.
    private async Task AbrirPreviewAsync(int id)
    {
        erro = null;
        var completa = await QuestaoService.CarregarVisivelAsync(id, meuId, minhaInstituicaoId);
        if (completa is null)
        {
            erro = "Questão não encontrada.";
            return;
        }
        questaoPreview = completa;
        questaoPreviewUltimoUso = await QuestaoQueryService.ObterUltimoUsoAsync(id);
    }

    private void FecharPreview()
    {
        questaoPreview = null;
        questaoPreviewUltimoUso = null;
    }

    private static string Truncar(string texto) => texto.Length > 160 ? texto[..160] + "..." : texto;
}
