    // Preenche o Bloom só de quem está em branco, entre as MINHAS questões
    // (é uma edição de metadado, então segue a mesma regra de posse do resto
    // — não mexe em questão de outro professor mesmo que compartilhada).
    // Heurística por palavras-chave, aproximada — revise depois.
    private async Task ClassificarBloomAsync()
    {
        erro = null;
        sucesso = null;

        var (classificadas, semSugestao) = await QuestaoService.ClassificarBloomAutomaticamenteAsync(meuId);

        sucesso = classificadas == 0
            ? "Nenhuma questão sua sem Bloom tinha um verbo reconhecível pra sugerir automaticamente."
            : $"{classificadas} questão(ões) classificada(s) por Bloom automaticamente." +
                (semSugestao > 0 ? $" {semSugestao} continuaram sem sugestão clara — classifique manualmente." : "");

