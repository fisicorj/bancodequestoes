@page "/questoes"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using BancoQuestoes.Importacao
@using BancoQuestoes.Exportacao
@inject QuestaoService QuestaoService
@inject DisciplinaService DisciplinaService
@inject CursoService CursoService
@inject MatrizReferenciaService MatrizService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager

<PageTitle>Questões</PageTitle>

<h1>Questões</h1>

<p>
    <a class="btn btn-primary" href="questoes/novo">+ Nova questão</a>
    <a class="btn btn-outline-primary" href="questoes/importar">Importar (Aiken/GIFT)</a>
    <button type="button" class="btn btn-outline-secondary" @onclick="ClassificarBloomAsync">
        Classificar Bloom automaticamente
    </button>
</p>

@if (sucesso is not null)
{
    <div class="alert alert-success">@sucesso</div>
}

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}

<div class="row g-2 align-items-end mb-3 p-3 bg-light border rounded">
    <div class="col-12 col-md-4">
        <label class="form-label small mb-1">Buscar no enunciado</label>
        <input type="text" class="form-control" placeholder="Digite para buscar..."
               @bind="filtroTexto" @bind:event="oninput" @bind:after="AplicarFiltroAsync" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Disciplina</label>
        <select class="form-select" @bind="filtroDisciplinaId" @bind:after="AoMudarDisciplinaAsync">
            <option value="0">Todas</option>
            @foreach (var d in disciplinas)
            {
                <option value="@d.Id">@d.Nome</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Assunto</label>
        <select class="form-select" @bind="filtroAssuntoId" @bind:after="AplicarFiltroAsync">
            <option value="0">Todos</option>
            @foreach (var a in AssuntosDoFiltro)
            {
                <option value="@a.Id">@a.Nome</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Tipo</label>
        <select class="form-select" @bind="filtroTipo" @bind:after="AplicarFiltroAsync">
            <option value="">Todos</option>
            <option value="@TipoQuestao.MultiplaEscolha">Múltipla escolha</option>
            <option value="@TipoQuestao.Discursiva">Discursiva</option>
            <option value="@TipoQuestao.CertoErrado">Certo/Errado</option>
            <option value="@TipoQuestao.Associacao">Associação</option>
            <option value="@TipoQuestao.RespostaBreve">Resposta breve</option>
            <option value="@TipoQuestao.Numerica">Numérica</option>
            <option value="@TipoQuestao.Lacunas">Preenchimento de lacunas</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Dificuldade</label>
        <select class="form-select" @bind="filtroDificuldade" @bind:after="AplicarFiltroAsync">
            <option value="">Todas</option>
            <option value="@Dificuldade.Facil">Fácil</option>
            <option value="@Dificuldade.Media">Média</option>
            <option value="@Dificuldade.Dificil">Difícil</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Visibilidade</label>
        <select class="form-select" @bind="filtroVisibilidade" @bind:after="AplicarFiltroAsync">
            <option value="">Todas</option>
            <option value="@VisibilidadeQuestao.Privada">🔒 Só eu</option>
            <option value="@VisibilidadeQuestao.Institucional">👥 Instituição</option>
            <option value="@VisibilidadeQuestao.Compartilhada">🌐 Todos</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Bloom</label>
        <select class="form-select" @bind="filtroBloom" @bind:after="AplicarFiltroAsync">
            <option value="">Todos</option>
            <option value="@NivelBloom.Lembrar">Lembrar</option>
            <option value="@NivelBloom.Entender">Entender</option>
            <option value="@NivelBloom.Aplicar">Aplicar</option>
            <option value="@NivelBloom.Analisar">Analisar</option>
            <option value="@NivelBloom.Avaliar">Avaliar</option>
            <option value="@NivelBloom.Criar">Criar</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Origem</label>
        <select class="form-select" @bind="filtroOrigem" @bind:after="AplicarFiltroAsync">
            <option value="">Todas</option>
            <option value="@OrigemQuestao.Autoral">Autoral</option>
            <option value="@OrigemQuestao.Livro">Livro</option>
            <option value="@OrigemQuestao.Enade">ENADE</option>
            <option value="@OrigemQuestao.Concurso">Concurso</option>
            <option value="@OrigemQuestao.Vestibular">Vestibular</option>
            <option value="@OrigemQuestao.Importada">Importada</option>
            <option value="@OrigemQuestao.Ia">IA</option>
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Curso</label>
        <select class="form-select" @bind="filtroCursoId" @bind:after="AoMudarCursoFiltroAsync">
            <option value="0">Todos</option>
            @foreach (var c in cursos)
            {
                <option value="@c.Id">@c.Instituicao?.Nome / @c.Nome</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Matriz / ENADE</label>
        <select class="form-select" @bind="filtroMatrizId" @bind:after="AoMudarMatrizFiltroAsync" disabled="@(filtroCursoId == 0)">
            <option value="0">@(filtroCursoId == 0 ? "Escolha o curso primeiro..." : "Todas")</option>
            @foreach (var m in matrizesDoFiltroCurso)
            {
                <option value="@m.Id">@m.Nome</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-1">Item da matriz</label>
        <select class="form-select" @bind="filtroItemMatrizId" @bind:after="AplicarFiltroAsync" disabled="@(filtroMatrizId == 0)">
            <option value="0">@(filtroMatrizId == 0 ? "Escolha a matriz primeiro..." : "Todos")</option>
            @foreach (var i in itensDoFiltroMatriz)
            {
                <option value="@i.Id">@i.Codigo — @i.Titulo</option>
            }
        </select>
    </div>
    @if (todasTags.Count > 0)
    {
        <div class="col-12">
            <label class="form-label small mb-1">Tags</label>
            <div class="d-flex flex-wrap gap-1">
                @foreach (var tag in todasTags)
                {
                    <button type="button" class="btn btn-sm @(filtroTagIds.Contains(tag.Id) ? "btn-primary" : "btn-outline-secondary")" @onclick="() => AlternarFiltroTagAsync(tag.Id)">
                        @tag.Nome
                    </button>
                }
            </div>
        </div>
    }
    <div class="col-12 d-flex align-items-center justify-content-between mt-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="mostrarInativas" @bind="mostrarInativas" @bind:after="AplicarFiltroAsync" />
            <label class="form-check-label" for="mostrarInativas">Mostrar inativas</label>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LimparFiltrosAsync">Limpar filtros</button>
    </div>
</div>

@if (questoes is null)
{
    <p><em>Carregando...</em></p>
}
else if (questoes.Count == 0)
{
    <p><em>Nenhuma questão encontrada com os filtros atuais.</em></p>
}
else
{
    <p class="text-muted small">
        Mostrando @((pagina - 1) * TamanhoPagina + 1)–@((pagina - 1) * TamanhoPagina + questoes.Count) de @totalRegistros questão(ões).
    </p>

    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="selecionarPagina" checked="@TodasNaPaginaSelecionadas" @onchange="AlternarSelecaoPagina" />
            <label class="form-check-label small" for="selecionarPagina">Selecionar todas nesta página</label>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(selecionadas.Count == 0)" @onclick="ExportarGiftAsync">
            Exportar selecionadas (GIFT)
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(selecionadas.Count == 0)" @onclick="ExportarAikenAsync">
            Exportar selecionadas (Aiken)
        </button>
        @if (selecionadas.Count > 0)
        {
            <span class="text-muted small">@selecionadas.Count selecionada(s)</span>
        }
    </div>

    <div class="d-flex flex-column gap-3">
        @foreach (var q in questoes)
        {
            var minha = q.CriadoPorId == meuId;
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
                        <div class="d-flex align-items-center gap-2">
                            <input type="checkbox" class="form-check-input mt-0" checked="@selecionadas.Contains(q.Id)" @onchange="e => AlternarSelecao(q.Id, (bool)e.Value!)" />
                            <span class="fw-bold text-muted">Q@(q.Id)</span>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            @{ var qualidadeQ = QualidadeQuestao.Calcular(q); }
                            <span class="badge text-bg-@qualidadeQ.CorFarol" title="@(qualidadeQ.CriteriosFaltando.Count > 0 ? "Faltando: " + string.Join(", ", qualidadeQ.CriteriosFaltando) : "Todos os critérios atendidos")">
                                Qualidade: @qualidadeQ.Percentual%
                            </span>
                            <span class="badge text-bg-light border" title="@(minha ? "" : "Criada por outro professor")">@RotuloVisibilidade(q.Visibilidade)</span>
                            <span class="badge @(q.Ativa ? "text-bg-success" : "text-bg-secondary")">@(q.Ativa ? "Ativa" : "Inativa")</span>
                        </div>
                    </div>

                    <p class="text-muted small mb-1">@q.Assunto?.Disciplina?.Nome / @q.Assunto?.Nome</p>

                    <p class="mb-2">@Truncar(q.Enunciado)</p>

                    <p class="text-muted small mb-1">
                        @RotuloTipo(q.TipoQuestao) • @q.Dificuldade@(q.Bloom is { } bloom ? $" • {RotuloBloom(bloom)}" : "")
                    </p>

                    @if (q.ItensMatriz.Count > 0)
                    {
                        <p class="mb-1">
                            <span class="text-muted small">Alinhamento:</span>
                            @foreach (var grupoMatriz in q.ItensMatriz.GroupBy(i => i.MatrizReferencia?.Nome ?? "").OrderBy(g => g.Key))
                            {
                                <span class="text-muted small">@grupoMatriz.Key:</span>
                                @foreach (var item in grupoMatriz.OrderBy(i => i.Codigo))
                                {
                                    <span class="badge text-bg-light border" title="@item.Titulo">@item.Codigo</span>
                                }
                            }
                        </p>
                    }

                    @{ var usos = usosPorQuestao.GetValueOrDefault(q.Id); }
                    <p class="text-muted small mb-1">
                        @(usos > 0 ? $"Usada {usos} vez(es)" : "Nunca usada")
                        @if (usos >= LimiarAltaExposicao)
                        {
                            <span class="badge text-bg-warning" title="Usada @usos vezes — considere dar preferência a questões menos usadas.">⚠ Alta exposição</span>
                        }
                        •
                        Atualizada @TempoRelativo(q.AtualizadoEm ?? q.CriadoEm)
                    </p>
                    @if (ultimoUsoPorQuestao.TryGetValue(q.Id, out var ultimoUso))
                    {
                        <p class="text-muted small mb-2">Última utilização: @ultimoUso.Rotulo</p>
                    }

                    @if (q.Tags.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var tag in q.Tags.OrderBy(t => t.Nome))
                            {
                                <span class="badge text-bg-light border">@tag.Nome</span>
                            }
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2">
                        @if (minha)
                        {
                            <a class="btn btn-sm btn-secondary" href="@($"questoes/editar/{q.Id}")">Editar</a>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => DuplicarAsync(q)">Duplicar</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AbrirPreviewAsync(q.Id)">
                            <i class="bi bi-eye" aria-hidden="true"></i> Prévia
                        </button>
                        @if (minha)
                        {
                            <button type="button" class="btn btn-sm @(q.Ativa ? "btn-warning" : "btn-success")" @onclick="() => AlternarAtivaAsync(q)">
                                @(q.Ativa ? "Desativar" : "Reativar")
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => ConfirmarExcluirAsync(q)">Excluir</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-3">
        <Paginacao Pagina="pagina" TamanhoPagina="TamanhoPagina" TotalRegistros="totalRegistros" PaginaChanged="MudarPaginaAsync" />
    </div>
}

@if (questaoPreview is not null)
{
    <div class="modal-backdrop fade show" @onclick="FecharPreview"></div>
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Prévia da questão</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="FecharPreview"></button>
                </div>
                <div class="modal-body">
                    @{ var qualidadePreview = QualidadeQuestao.Calcular(questaoPreview); }
                    <p class="mb-1">
                        <span class="badge text-bg-@qualidadePreview.CorFarol">Qualidade: @qualidadePreview.Percentual%</span>
                        @if (qualidadePreview.CriteriosFaltando.Count > 0)
                        {
                            <span class="text-muted small ms-1">Faltando: @string.Join(", ", qualidadePreview.CriteriosFaltando)</span>
                        }
                    </p>
                    <p class="text-muted small mb-1">
                        @RotuloTipo(questaoPreview.TipoQuestao) • @questaoPreview.Dificuldade • @questaoPreview.Assunto?.Disciplina?.Nome / @questaoPreview.Assunto?.Nome
                        @(questaoPreview.Bloom is { } previaBloom ? $" • {RotuloBloom(previaBloom)}" : "")
                    </p>
                    <p class="text-muted small mb-2">
                        Origem: @RotuloOrigem(questaoPreview.Origem)@(questaoPreview.Ano is { } ano ? $" ({ano})" : "")@(string.IsNullOrWhiteSpace(questaoPreview.Referencia) ? "" : $" — {questaoPreview.Referencia}")
                    </p>
                    @{ var previaUsos = usosPorQuestao.GetValueOrDefault(questaoPreview.Id); }
                    <p class="text-muted small mb-2">
                        @(previaUsos > 0 ? $"Utilizada {previaUsos} vez(es)" : "Nunca utilizada")
                        @if (previaUsos >= LimiarAltaExposicao)
                        {
                            <span class="badge text-bg-warning">⚠ Alta exposição</span>
                        }
                        @(questaoPreviewUltimoUso is not null ? $" • Última utilização: {questaoPreviewUltimoUso.Rotulo}" : "")
                    </p>
                    @if (questaoPreview.Tags.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var tag in questaoPreview.Tags.OrderBy(t => t.Nome))
                            {
                                <span class="badge text-bg-light border">@tag.Nome</span>
                            }
                        </div>
                    }

                    @if (questaoPreview.ItensMatriz.Count > 0)
                    {
                        <div class="mb-2">
                            <p class="text-muted small mb-1"><strong>Alinhamento curricular:</strong></p>
                            @foreach (var grupoMatriz in questaoPreview.ItensMatriz.GroupBy(i => i.MatrizReferencia?.Nome ?? "").OrderBy(g => g.Key))
                            {
                                <p class="small mb-1 fw-bold">@grupoMatriz.Key</p>
                                <ul class="small mb-0">
                                    @foreach (var item in grupoMatriz.OrderBy(i => i.Codigo))
                                    {
                                        <li>
                                            <span class="badge text-bg-secondary">@item.Tipo.Rotulo()</span>
                                            <strong>@item.Codigo</strong> — @item.Titulo
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    <div class="markdown-preview mb-3">@RenderizarEnunciadoPreview(questaoPreview)</div>

                    @if (questaoPreview.Imagens.Count > 0)
                    {
                        <div class="mb-3">
                            @foreach (var img in questaoPreview.Imagens.OrderBy(i => i.Ordem))
                            {
                                <div class="mb-2" style="text-align: @AlinhamentoCss(img.Alinhamento);">
                                    <img src="@($"questoes/imagem/{img.Id}")" alt="@(img.TextoAlternativo ?? img.NomeArquivo)"
                                         style="width: @(img.LarguraPercentual ?? 60)%; max-width: 100%;" />
                                    @if (!string.IsNullOrWhiteSpace(img.Legenda))
                                    {
                                        <div class="text-muted small fst-italic">@img.Legenda</div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @switch (questaoPreview)
                    {
                        case QuestaoMultiplaEscolha me:
                            <ol type="A" class="mb-0">
                                @foreach (var alt in me.Alternativas.OrderBy(a => a.Letra))
                                {
                                    <li class="@(alt.Letra == me.RespostaCorreta ? "fw-bold text-success" : "")">
                                        @alt.Texto @(alt.Letra == me.RespostaCorreta ? "✓" : "")
                                    </li>
                                }
                            </ol>
                            break;

                        case QuestaoCertoErrado ce:
                            <p class="mb-0">
                                (@(ce.RespostaCorreta ? "✓" : "  ")) Certo &nbsp;&nbsp;&nbsp; (@(!ce.RespostaCorreta ? "✓" : "  ")) Errado
                            </p>
                            break;

                        case QuestaoDiscursiva d:
                            <p class="mb-1"><strong>Resposta esperada:</strong> @d.RespostaEsperada</p>
                            @if (!string.IsNullOrWhiteSpace(d.CriterioAvaliacao))
                            {
                                <p class="mb-0 text-muted small"><strong>Critério de avaliação:</strong> @d.CriterioAvaliacao</p>
                            }
                            break;

                        case QuestaoRespostaBreve rb:
                            <p class="mb-0"><strong>Resposta esperada:</strong> @rb.RespostaEsperada</p>
                            break;

                        case QuestaoNumerica num:
                            <p class="mb-0">
                                <strong>Resposta esperada:</strong> @num.RespostaEsperada.ToString("0.####")
                                @(num.Tolerancia > 0 ? $" (± {num.Tolerancia:0.####})" : "")
                            </p>
                            break;

                        case QuestaoAssociacao assoc:
                            var pares = assoc.Pares.OrderBy(p => p.Ordem).ToList();
                            <div class="row">
                                <div class="col-6">
                                    @for (var i = 0; i < pares.Count; i++)
                                    {
                                        <p class="mb-1">@(i + 1). @pares[i].Termo</p>
                                    }
                                </div>
                                <div class="col-6">
                                    @for (var i = 0; i < pares.Count; i++)
                                    {
                                        <p class="mb-1">@LetraDe(i)) @pares[i].Correspondente</p>
                                    }
                                </div>
                            </div>
                            break;

                        case QuestaoLacunas lac:
                            <p class="mb-0 text-muted small">
                                <strong>Respostas esperadas:</strong>
                                @string.Join("; ", lac.Lacunas.OrderBy(l => l.Ordem).Select((l, i) => $"({i + 1}) {l.RespostaEsperada}"))
                            </p>
                            break;
                    }

                    @if (!string.IsNullOrWhiteSpace(questaoPreview.Explicacao))
                    {
                        <hr />
                        <p class="text-muted small mb-1"><strong>Explicação da resposta:</strong></p>
                        <div class="markdown-preview">@RenderizarPreview(questaoPreview.Explicacao)</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharPreview">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Questao>? questoes;
    private List<Disciplina> disciplinas = new();
    private List<Assunto> todosAssuntos = new();
    private bool mostrarInativas;

    private string filtroTexto = "";
    private int filtroDisciplinaId;
    private int filtroAssuntoId;
    private TipoQuestao? filtroTipo;
    private Dificuldade? filtroDificuldade;
    private VisibilidadeQuestao? filtroVisibilidade;
    private NivelBloom? filtroBloom;
    private OrigemQuestao? filtroOrigem;
    private HashSet<int> filtroTagIds = new();
    private List<Tag> todasTags = new();
    private string? sucesso;
    private string? erro;

    // Alinhamento Curricular / ENADE — CursoId escopa o <select> de Matriz
    // (igual Disciplina escopa Assunto acima); MatrizReferenciaId escopa o
    // <select> de Item; ItemMatrizId é quem filtra de fato (ver
    // QuestaoService.ListarAsync). Itens são flat, então o filtro é direto,
    // sem precisar expandir descendentes como no antigo modelo de Diretriz.
    private List<Curso> cursos = new();
    private int filtroCursoId;
    private int filtroMatrizId;
    private int filtroItemMatrizId;
    private List<MatrizReferencia> matrizesDoFiltroCurso = new();
    private List<ItemMatrizReferencia> itensDoFiltroMatriz = new();

    private const int TamanhoPagina = 20;
    private int pagina = 1;
    private int totalRegistros;

    // Limiar simples e fixo pra marcar uma questão como "alta exposição" —
    // não é uma ciência exata, é só um alerta visual pro professor considerar
    // dar preferência a outras questões. O gerador (ProvaService.Sortear) usa
    // um critério mais refinado (peso decrescente por uso, não um corte fixo).
    private const int LimiarAltaExposicao = 10;

    private Dictionary<int, int> usosPorQuestao = new();
    private Dictionary<int, UltimoUsoInfo> ultimoUsoPorQuestao = new();
    private UltimoUsoInfo? questaoPreviewUltimoUso;
    private HashSet<int> selecionadas = new();
    private string? meuId;
    private int? minhaInstituicaoId;

    private Questao? questaoPreview;

    [SupplyParameterFromQuery(Name = "msg")]
    private string? Msg { get; set; }

    // Lista de assuntos exibida no <select>, restrita à disciplina escolhida
    // (ou todas, se nenhuma disciplina estiver selecionada no filtro).
    private IEnumerable<Assunto> AssuntosDoFiltro => filtroDisciplinaId == 0
        ? todosAssuntos
        : todosAssuntos.Where(a => a.DisciplinaId == filtroDisciplinaId);

    private bool TodasNaPaginaSelecionadas => questoes is { Count: > 0 } && questoes.All(q => selecionadas.Contains(q.Id));

    protected override async Task OnInitializedAsync()
    {
        sucesso = Msg;
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        meuId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        minhaInstituicaoId = await QuestaoService.ObterInstituicaoDoUsuarioAsync(meuId);
        disciplinas = await DisciplinaService.ListarTodasAsync();
        todosAssuntos = await DisciplinaService.ListarTodosAssuntosAsync();
        todasTags = await QuestaoService.ListarTagsAsync();
        cursos = await CursoService.ListarTodosAsync();
        await CarregarAsync();
    }

    // Trocar o curso invalida a matriz/item selecionados (podem ser de outro
    // curso), mesma lógica de AoMudarDisciplinaAsync abaixo pra Assunto.
    private async Task AoMudarCursoFiltroAsync()
    {
        filtroMatrizId = 0;
        filtroItemMatrizId = 0;
        itensDoFiltroMatriz = new();
        matrizesDoFiltroCurso = filtroCursoId == 0
            ? new()
            : await MatrizService.ListarPorCursoAsync(filtroCursoId);
        pagina = 1;
        await CarregarAsync();
    }

    // Trocar a matriz invalida o item selecionado (ele pode ser de outra
    // matriz).
    private async Task AoMudarMatrizFiltroAsync()
    {
        filtroItemMatrizId = 0;
        itensDoFiltroMatriz = filtroMatrizId == 0
            ? new()
            : await MatrizService.ListarItensAsync(filtroMatrizId);
        pagina = 1;
        await CarregarAsync();
    }

    private async Task AlternarFiltroTagAsync(int tagId)
    {
        if (!filtroTagIds.Add(tagId))
        {
            filtroTagIds.Remove(tagId);
        }
        pagina = 1;
        await CarregarAsync();
    }

    // Trocar a disciplina invalida o assunto selecionado (ele pode pertencer
    // a outra disciplina), então zera antes de recarregar.
    private async Task AoMudarDisciplinaAsync()
    {
        filtroAssuntoId = 0;
        pagina = 1;
        await CarregarAsync();
    }

    // Qualquer mudança de filtro volta pra primeira página — senão o usuário pode
    // ficar "preso" numa página que não existe mais pro novo resultado filtrado.
    private async Task AplicarFiltroAsync()
    {
        pagina = 1;
        await CarregarAsync();
    }

    private async Task LimparFiltrosAsync()
    {
        filtroTexto = "";
        filtroDisciplinaId = 0;
        filtroAssuntoId = 0;
        filtroTipo = null;
        filtroDificuldade = null;
        filtroVisibilidade = null;
        filtroBloom = null;
        filtroOrigem = null;
        filtroTagIds.Clear();
        filtroCursoId = 0;
        filtroMatrizId = 0;
        filtroItemMatrizId = 0;
        matrizesDoFiltroCurso = new();
        itensDoFiltroMatriz = new();
        mostrarInativas = false;
        pagina = 1;
        await CarregarAsync();
    }

    private async Task MudarPaginaAsync(int novaPagina)
    {
        pagina = novaPagina;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        var filtro = new QuestaoFiltro
        {
            Texto = filtroTexto,
            DisciplinaId = filtroDisciplinaId,
            AssuntoId = filtroAssuntoId,
            Tipo = filtroTipo,
            Dificuldade = filtroDificuldade,
            Visibilidade = filtroVisibilidade,
            Bloom = filtroBloom,
            Origem = filtroOrigem,
            TagIds = filtroTagIds,
            MostrarInativas = mostrarInativas,
            CursoId = filtroCursoId,
            MatrizReferenciaId = filtroMatrizId,
            ItemMatrizId = filtroItemMatrizId,
        };

        var resultado = await QuestaoService.ListarAsync(filtro, meuId, minhaInstituicaoId, pagina, TamanhoPagina);
        questoes = resultado.Itens;
        totalRegistros = resultado.Total;

        var idsNaPagina = questoes.Select(q => q.Id).ToList();
        (usosPorQuestao, ultimoUsoPorQuestao) = await QuestaoService.ObterUsoAsync(idsNaPagina);
    }

    private void AlternarSelecao(int id, bool marcado)
    {
        if (marcado)
        {
            selecionadas.Add(id);
        }
        else
        {
            selecionadas.Remove(id);
        }
    }

    private void AlternarSelecaoPagina(ChangeEventArgs e)
    {
        if (questoes is null)
        {
            return;
        }

        var marcar = (bool)e.Value!;
        foreach (var q in questoes)
        {
            if (marcar)
            {
                selecionadas.Add(q.Id);
            }
            else
            {
                selecionadas.Remove(q.Id);
            }
        }
    }

    private async Task AlternarAtivaAsync(Questao q)
    {
        erro = null;
        try
        {
            await QuestaoService.AlternarAtivaAsync(q, meuId);
            await CarregarAsync();
        }
        catch (OperacaoInvalidaException ex)
        {
            erro = ex.Message;
        }
    }

