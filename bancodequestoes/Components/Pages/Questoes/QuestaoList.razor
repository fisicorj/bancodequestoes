        }
    }

    private Task ExportarGiftAsync() => ExportarAsync("gift");

    private Task ExportarAikenAsync() => ExportarAsync("aiken");

    private async Task ExportarAsync(string formato)
    {
        erro = null;
        sucesso = null;

        var completas = new List<Questao>();
        foreach (var id in selecionadas)
        {
            var q = await QuestaoService.CarregarVisivelAsync(id, meuId, minhaInstituicaoId);
            if (q is not null)
            {
                completas.Add(q);
            }
        }

        var (conteudo, ignoradas) = formato == "gift" ? GiftExporter.Gerar(completas) : AikenExporter.Gerar(completas);

        if (string.IsNullOrWhiteSpace(conteudo))
        {
            erro = "Nenhuma das questões selecionadas pôde ser exportada nesse formato.";
            return;
        }

        var extensao = formato == "gift" ? "gift.txt" : "aiken.txt";
        var nomeArquivo = $"questoes-{DateTime.Now:yyyyMMdd-HHmm}.{extensao}";
        await JS.InvokeVoidAsync("bqDownloadText", nomeArquivo, conteudo);

        if (ignoradas.Count > 0)
        {
            var amostra = string.Join("; ", ignoradas.Take(5));
            var resto = ignoradas.Count > 5 ? $" (e mais {ignoradas.Count - 5})" : "";
            erro = $"{ignoradas.Count} questão(ões) sem equivalente nesse formato foram ignoradas: {amostra}{resto}.";
        }
        else
        {
            sucesso = $"{completas.Count} questão(ões) exportada(s) com sucesso.";
        }
    }

    // Prévia "exatamente como vai sair na prova": carrega a questão completa
    // (mesmo caminho de Duplicar/Exportar) e mostra num modal — enunciado
    // renderizado em Markdown+LaTeX, imagens, e o corpo específico do tipo
    // (alternativas com a correta marcada, resposta esperada etc.). É uma
    // visão "de professor" (mostra a resposta certa) — não simula a versão
    // embaralhada que sai no PDF/DOCX, só o conteúdo.
    private async Task AbrirPreviewAsync(int id)
    {
        erro = null;
        var completa = await QuestaoService.CarregarVisivelAsync(id, meuId, minhaInstituicaoId);
        if (completa is null)
        {
            erro = "Questão não encontrada.";
            return;
        }
        questaoPreview = completa;
        questaoPreviewUltimoUso = await QuestaoService.ObterUltimoUsoAsync(id);
    }

    private void FecharPreview()
    {
        questaoPreview = null;
        questaoPreviewUltimoUso = null;
    }

    // Lacunas precisa do mesmo texto com marcadores numerados que aparece na
    // prova exportada (ver ProvaExportLoader.SubstituirMarcadoresDeLacuna) —
    // senão a prévia mostraria "___" cru em vez de "_____(1)_____".
    private MarkupString RenderizarEnunciadoPreview(Questao q)
    {
        var texto = q.TipoQuestao == TipoQuestao.Lacunas
            ? ProvaExportLoader.SubstituirMarcadoresDeLacuna(q.Enunciado)
            : q.Enunciado;
        return (MarkupString)MarkdownPreview.ParaHtml(texto);
    }

    // Mesma conversão usada pro enunciado (Markdown -> HTML), reaproveitada
    // pra mostrar a Explicação da resposta no modal de prévia.
    private static MarkupString RenderizarPreview(string markdown) => (MarkupString)MarkdownPreview.ParaHtml(markdown);

    private static char LetraDe(int indice) => (char)('A' + indice);

    // Formata a diferença entre "agora" e uma data em texto relativo curto
    // ("há 5 dias", "ontem", "há 2 meses"...) — usado na listagem em vez da
    // data completa, mais rápido de escanear numa lista de questões.
    private static string TempoRelativo(DateTime dataUtc)
    {
        var diff = DateTime.UtcNow - dataUtc;
        if (diff.TotalMinutes < 1)
        {
            return "agora mesmo";
        }
        if (diff.TotalMinutes < 60)
        {
            return $"há {(int)diff.TotalMinutes} min";
        }
        if (diff.TotalHours < 24)
        {
            return $"há {(int)diff.TotalHours}h";
        }
        if (diff.TotalDays < 2)
        {
            return "ontem";
        }
        if (diff.TotalDays < 30)
        {
            return $"há {(int)diff.TotalDays} dias";
        }
        if (diff.TotalDays < 365)
        {
            var meses = (int)(diff.TotalDays / 30);
            return $"há {meses} {(meses == 1 ? "mês" : "meses")}";
        }
        var anos = (int)(diff.TotalDays / 365);
        return $"há {anos} {(anos == 1 ? "ano" : "anos")}";
    }

    private static string Truncar(string texto) => texto.Length > 160 ? texto[..160] + "..." : texto;

