@page "/questoes/novo"
@page "/questoes/editar/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using BancoQuestoes.Exportacao
@using BancoQuestoes.Components.Pages.Questoes.Components
@using BancoQuestoes.Components.Pages.Questoes.Components.Tipos
@inject QuestaoService QuestaoService
@inject QuestaoTagService QuestaoTagService
@inject QuestaoHistoricoService QuestaoHistoricoService
@inject DisciplinaService DisciplinaService
@inject CursoService CursoService
@inject AreaCursoService AreaCursoService
@inject MatrizReferenciaService MatrizService
@inject RascunhoQuestaoIaService RascunhoIa
@inject SugestaoIaService SugestaoIa
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>@(Id is null ? "Nova questão" : "Editar questão")</PageTitle>


<PageHeader Titulo="@(Id is null ? "Nova questão" : "Editar questão")">
    <Acao>
        @if (Id is not null && qualidade is not null)
        {
            <span class="badge text-bg-@qualidade.CorFarol" title="@(qualidade.CriteriosFaltando.Count > 0 ? "Faltando: " + string.Join(", ", qualidade.CriteriosFaltando) : "Todos os critérios atendidos")">
                Qualidade: @qualidade.Percentual%
            </span>
        }
    </Acao>
</PageHeader>

@if (erro is not null)
{
    <div class="alert alert-danger" style="white-space: pre-line">@erro</div>
}

@if (carregando)
{
    <p><em>Carregando...</em></p>
}
else if (acessoNegado)
{
    <p><a href="questoes">Voltar para questões</a></p>
}
else if (assuntos.Count == 0)
{
    <p><em>Cadastre um assunto antes de criar uma questão.</em> <a href="assuntos/novo">Criar assunto</a></p>
}
else
{
    <div class="row">
    <div class="col-md-8">
    <div class="form-card">
    <EditForm Model="modelo" OnValidSubmit="SalvarAsync" OnInvalidSubmit="AoSubmitInvalido">
        <DataAnnotationsValidator />

        @if (resumoErros > 0)
        {
            <div class="alert alert-warning">
                Existem @resumoErros campo(s) que precisa(m) de atenção.
            </div>
        }
        <ValidationSummary class="text-danger" />

        <!-- 1. CONTEÚDO DA QUESTÃO — dominante de propósito: é a primeira
             coisa que o professor preenche, antes de qualquer classificação. -->
        <div class="form-section">
            <h2 class="section-title">Conteúdo da questão</h2>
            <p class="section-subtitle mb-3">O que a questão pergunta e como ela é respondida.</p>

            <div class="form-floating mb-3" style="max-width: 420px;">
                <InputSelect @bind-Value="modelo.TipoQuestao" id="Tipo" class="form-select" disabled="@(Id is not null)">
                    <option value="@TipoQuestao.MultiplaEscolha">Múltipla escolha</option>
                    <option value="@TipoQuestao.Discursiva">Discursiva</option>
                    <option value="@TipoQuestao.CertoErrado">Certo/Errado</option>
                    <option value="@TipoQuestao.Associacao">Associação</option>
                    <option value="@TipoQuestao.RespostaBreve">Resposta breve</option>
                    <option value="@TipoQuestao.Numerica">Numérica</option>
                    <option value="@TipoQuestao.Lacunas">Preenchimento de lacunas</option>
                </InputSelect>
                <label for="Tipo">Tipo</label>
            </div>

            <EnunciadoEditor Modelo="modelo" Pendentes="pendentes" />

            @if (modelo.TipoQuestao == TipoQuestao.MultiplaEscolha)
            {
                <MultiplaEscolhaEditor Modelo="modelo" />
            }
            else if (modelo.TipoQuestao == TipoQuestao.Discursiva)
            {
                <DiscursivaEditor Modelo="modelo" IaHabilitada="iaHabilitada" />
            }
            else if (modelo.TipoQuestao == TipoQuestao.CertoErrado)
            {
                <CertoErradoEditor Modelo="modelo" />
            }
            else if (modelo.TipoQuestao == TipoQuestao.Associacao)
            {
                <AssociacaoEditor Modelo="modelo" />
            }
            else if (modelo.TipoQuestao == TipoQuestao.RespostaBreve)
            {
                <RespostaBreveEditor Modelo="modelo" />
            }
            else if (modelo.TipoQuestao == TipoQuestao.Numerica)
            {
                <NumericaEditor Modelo="modelo" />
            }
            else if (modelo.TipoQuestao == TipoQuestao.Lacunas)
            {
                <LacunasEditor Modelo="modelo" />
            }

            <ExplicacaoEditor Modelo="modelo" IaHabilitada="iaHabilitada" />

            <QuestaoImagensEditor ImagensExistentes="imagensExistentes" ImagensParaRemover="imagensParaRemover" Pendentes="pendentes" />
        </div>

        <!-- 2. CLASSIFICAÇÃO — vem depois do conteúdo, não antes. -->
        <div class="form-section">
            <h2 class="section-title">Classificação</h2>
            <p class="section-subtitle mb-3">Disciplina, assunto, dificuldade e nível cognitivo — ajuda a encontrar e reaproveitar esta questão depois.</p>

            <QuestaoMetadadosSection Modelo="modelo"
                                     Disciplinas="disciplinas"
                                     Assuntos="assuntos"
                                     MinhaInstituicaoId="minhaInstituicaoId"
                                     @bind-DisciplinaId="disciplinaId"
                                     OnMudarDisciplina="AoMudarDisciplinaFiltro" />

            <QuestaoTagsEditor Modelo="modelo" TodasTagsExistentes="todasTagsExistentes" />
        </div>

        <!-- Assistente de IA — entre Classificação e Aderência Curricular
             porque sugere coisas dos dois; visual discreto de propósito
             (.ia-assistente-box), pra parecer apoio opcional, não requisito. -->
        <SugestaoIaCard Modelo="modelo"
                        IaHabilitada="iaHabilitada"
                        Assuntos="assuntos"
                        Disciplinas="disciplinas"
                        @bind-DisciplinaId="disciplinaId"
                        ItensMatrizDisponiveis="ItensEnadeParaSugestao"
                        OnAplicarItemMatriz="AplicarSugestaoItemMatrizAsync" />

        
        <div class="form-section">
            <QuestaoAlinhamentoCurricularSection Modelo="modelo"
                                                 Cursos="cursos"
                                                 AreasCurso="areasCurso"
                                                 ItensDoCurso="itensDoCurso"
                                                 ItensDasAreas="itensDasAreas"
                                                 ItensHistoricos="ItensHistoricos"
                                                 ItemMatrizIdsSelecionados="itemMatrizIdsSelecionados"
                                                 OnAlternarAreaCurso="AoAlternarAreaCursoAsync"
                                                 OnAlternarCursoContexto="AoAlternarCursoContextoAsync"
                                                 OnItemAlterado="SincronizarDetalhesItensSelecionados" />
        </div>

        <!-- 4. CONFIGURAÇÕES ADICIONAIS — só existe em edição (Ativa não faz
             sentido pra uma questão que ainda nem foi criada). -->
        @if (Id is not null)
        {
            <div class="form-section">
                <h2 class="section-title">Configurações adicionais</h2>
                <div class="form-check mb-3">
                    <InputCheckbox @bind-Value="modelo.Ativa" class="form-check-input" id="Ativa" />
                    <label class="form-check-label" for="Ativa">Ativa</label>
                </div>
            </div>
        }

        <!-- Ação principal única + cancelar discreto (sem "Voltar"/"Duplicar"
             disputando peso visual aqui — essas ações já existem na listagem). -->
        <div class="d-flex align-items-center gap-3">
            <button type="submit" class="btn btn-primary" disabled="@salvando">
                @(salvando ? "Salvando..." : "Salvar questão")
            </button>
            <a href="questoes" class="btn btn-link">Cancelar</a>
        </div>
    </EditForm>
    </div>
    </div>
    </div>

    @if (Id is not null && historico.Count > 0)
    {
        <div class="row mt-3">
        <div class="col-md-8">
        <div class="form-card">
            <h5>Histórico de alterações</h5>
            <ul class="list-unstyled mb-0">
                @foreach (var h in historico)
                {
                    <li class="mb-3 pb-2 border-bottom">
                        <div class="text-muted small">
                            @h.DataHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm") —
                            @(h.Usuario?.NomeCompleto ?? h.Usuario?.Email ?? "professor removido")
                        </div>
                        <div>
                            @if (h.ValorAnterior is null && h.ValorNovo is null)
                            {
                                <text>@h.Campo alterado</text>
                            }
                            else
                            {
                                <text>@h.Campo: @h.ValorAnterior → @h.ValorNovo</text>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
        </div>
        </div>
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private QuestaoInput modelo = new();
    private List<Assunto> assuntos = new();
    private List<Disciplina> disciplinas = new();

    // Filtro em cascata Disciplina -> Assunto: não é campo de QuestaoInput, é só
    // estado da tela pra não listar assuntos de todas as disciplinas juntos.
    private int disciplinaId;

    // Trocar de disciplina invalida o assunto marcado; limpa pra não salvar
    // um par Disciplina/Assunto inconsistente.
    private void AoMudarDisciplinaFiltro() => modelo.AssuntoId = 0;

    // Nunca remove Item de Matriz em silêncio: bloqueia e avisa se deixaria item
    // órfão. Usa detalhesItensSelecionados pra não perder um vínculo histórico.
    private async Task AoAlternarAreaCursoAsync((int AreaCursoId, bool Marcado) evento)
    {
        erro = null;

        if (evento.Marcado)
        {
            // Marcar só acrescenta opções, nunca deixa nada órfão.
            if (!modelo.AreaCursoIds.Contains(evento.AreaCursoId))
            {
                modelo.AreaCursoIds.Add(evento.AreaCursoId);
            }
            await CarregarItensDasAreasAsync();
            return;
        }

        var itensDaArea = detalhesItensSelecionados.Values
            .Where(i => i.MatrizReferencia?.AreaCursoId == evento.AreaCursoId)
            .OrderBy(i => i.Codigo)
            .ToList();

        if (itensDaArea.Count > 0)
        {
            var nomeArea = areasCurso.FirstOrDefault(a => a.Id == evento.AreaCursoId)?.Nome ?? "selecionada";
            var listaItens = string.Join("\n", itensDaArea.Select(i => $"• {i.MatrizReferencia?.Nome} — {i.Codigo}"));
            erro = $"Não é possível remover a área \"{nomeArea}\" porque existem itens de matriz vinculados a ela:\n{listaItens}\nDesmarque esses itens antes de remover a área.";
            return;
        }

        modelo.AreaCursoIds.Remove(evento.AreaCursoId);
        await CarregarItensDasAreasAsync();
    }

    // Mesmo princípio, pro Curso institucional: bloqueia a troca (mesmo pra
    // "Nenhum") se o Curso atual ainda tiver item PPC selecionado.
    private async Task AoAlternarCursoContextoAsync(int? novoCursoId)
    {
        erro = null;

        if (novoCursoId == modelo.CursoContextoMatrizId)
        {
            return;
        }

        var itensDoCursoAtual = detalhesItensSelecionados.Values
            .Where(i => i.MatrizReferencia?.CursoId == modelo.CursoContextoMatrizId)
            .ToList();

        if (itensDoCursoAtual.Count > 0)
        {
            erro = "Não é possível alterar o contexto institucional enquanto existem itens de matriz vinculados ao curso atual. Remova primeiro os itens PPC/Institucionais selecionados.";
            return;
        }

        modelo.CursoContextoMatrizId = novoCursoId;
        if (novoCursoId is int cursoId)
        {
            await CarregarItensDoCursoAsync(cursoId);
        }
        else
        {
            itensDoCurso = new();
        }
    }

    private async Task CarregarItensDoCursoAsync(int cursoId) =>
        itensDoCurso = await MatrizService.ListarItensVinculaveisPorCursoAsync(cursoId);

    private async Task CarregarItensDasAreasAsync() =>
        itensDasAreas = modelo.AreaCursoIds.Count == 0
            ? new()
            : await MatrizService.ListarItensVinculaveisPorAreasCursoAsync(modelo.AreaCursoIds);

    // Substitui toda a seleção atual de Item de Matriz pela sugerida (não
    // acrescenta); marca a Área dona do item pra ele ficar selecionável no checklist.
    private async Task AplicarSugestaoItemMatrizAsync(ItemMatrizReferencia item)
    {
        erro = null;

        if (item.MatrizReferencia?.AreaCursoId is int areaCursoId && !modelo.AreaCursoIds.Contains(areaCursoId))
        {
            modelo.AreaCursoIds.Add(areaCursoId);
        }

        await CarregarItensDasAreasAsync();

        itemMatrizIdsSelecionados.Clear();
        itemMatrizIdsSelecionados.Add(item.Id);
        SincronizarDetalhesItensSelecionados();
    }

    // Mantém detalhesItensSelecionados em dia a cada marca/desmarca no checklist;
    // é essa informação que os bloqueios acima usam pra saber a Área/Curso de cada item.
    private void SincronizarDetalhesItensSelecionados()
    {
        foreach (var id in itemMatrizIdsSelecionados)
        {
            if (detalhesItensSelecionados.ContainsKey(id))
            {
                continue;
            }

            var item = itensDoCurso.FirstOrDefault(i => i.Id == id) ?? itensDasAreas.FirstOrDefault(i => i.Id == id);
            if (item is not null)
            {
                detalhesItensSelecionados[id] = item;
            }
        }

        foreach (var idObsoleto in detalhesItensSelecionados.Keys.Where(id => !itemMatrizIdsSelecionados.Contains(id)).ToList())
        {
            detalhesItensSelecionados.Remove(idObsoleto);
        }
    }

    private bool carregando;
    private bool iaHabilitada;
    private bool acessoNegado;
    private string? erro;
    private string? meuId;
    private int? minhaInstituicaoId;

    // Contador pro resumo curto no topo do formulário ("Existem N campos que
    // precisam de atenção") — só aparece depois de uma tentativa de salvar
    // que falhou na validação; não substitui o ValidationSummary/
    // ValidationMessage por campo, só complementa.
    private int resumoErros;

    private void AoSubmitInvalido(EditContext editContext) =>
        resumoErros = editContext.GetValidationMessages().Count();

    private List<Tag> todasTagsExistentes = new();

    private List<QuestaoImagem> imagensExistentes = new();
    private HashSet<int> imagensParaRemover = new();
    private List<PendenteImagem> pendentes = new();
    private List<QuestaoHistorico> historico = new();
    private QualidadeResultado? qualidade;

    // "cursos" é só contexto pra oferecer itens PPC/Institucionais; itensDoCurso/
    // itensDasAreas recarregam a cada troca de Curso/AreaCursoIds.
    private List<Curso> cursos = new();
    private List<AreaCurso> areasCurso = new();
    private List<ItemMatrizReferencia> itensDoCurso = new();
    private List<ItemMatrizReferencia> itensDasAreas = new();
    private HashSet<int> itemMatrizIdsSelecionados = new();

    // Itens selecionados que itensDoCurso/itensDasAreas não oferecem mais
    // (inativos ou matriz virou Rascunho); permite desmarcá-los explicitamente.
    private List<ItemMatrizReferencia> ItensHistoricos =>
        detalhesItensSelecionados.Values
            .Where(i => !i.Ativo || i.MatrizReferencia is null || !i.MatrizReferencia.PodeSerUtilizadaEmNovoVinculo())
            .Where(i => !itensDoCurso.Any(x => x.Id == i.Id) && !itensDasAreas.Any(x => x.Id == i.Id))
            .ToList();

    // Detalhe de cada item hoje selecionado; é contra este dicionário que os
    // bloqueios acima checam órfãos, mesmo vínculos históricos já inativados.
    private Dictionary<int, ItemMatrizReferencia> detalhesItensSelecionados = new();

    // Universo inteiro de itens ENADE ativos, carregado uma vez; o que vai pro
    // prompt da IA é ItensEnadeParaSugestao, que escopa pelas Áreas já marcadas.
    private List<ItemMatrizReferencia> itensEnadeDisponiveis = new();

    // Sem Área marcada ainda, cai pro catálogo inteiro (a sugestão pode indicar
    // qual marcar); com Área(s) marcada(s), escopa só a elas.
    private List<ItemMatrizReferencia> ItensEnadeParaSugestao =>
        modelo.AreaCursoIds.Count == 0
            ? itensEnadeDisponiveis
            : itensEnadeDisponiveis
                .Where(i => i.MatrizReferencia?.AreaCursoId is int areaId && modelo.AreaCursoIds.Contains(areaId))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        carregando = true;

        // Buscado UMA vez aqui e repassado por parâmetro pra ExplicacaoEditor e
        // SugestaoIaCard (em vez de cada um consultar sozinho no próprio
        // OnInitializedAsync): os dois são componentes-irmãos renderizados no
        // mesmo passe, e chamadas concorrentes ao mesmo DbContext (scoped, por
        // circuito) esbarravam em "A second operation was started on this
        // context instance before a previous operation completed".
        iaHabilitada = await SugestaoIa.HabilitadaAsync();

        assuntos = await DisciplinaService.ListarTodosAssuntosAsync();
        disciplinas = await DisciplinaService.ListarTodasAsync();
        todasTagsExistentes = await QuestaoTagService.ListarTagsAsync();
        cursos = await CursoService.ListarTodosAsync();
        areasCurso = await AreaCursoService.ListarAtivasAsync();
        itensEnadeDisponiveis = await MatrizService.ListarItensEnadeAtivosAsync();

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        meuId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        minhaInstituicaoId = await QuestaoService.ObterInstituicaoDoUsuarioAsync(meuId);

        if (Id is not null)
        {
            try
            {
                var questao = await QuestaoService.CarregarParaEdicaoAsync(Id.Value, meuId);
                modelo.AssuntoId = questao.AssuntoId;
                // Pré-seleciona a disciplina do filtro a partir do assunto salvo,
                // senão o select de Assunto esconderia a opção já marcada.
                disciplinaId = assuntos.FirstOrDefault(a => a.Id == questao.AssuntoId)?.DisciplinaId ?? 0;
                modelo.Enunciado = questao.Enunciado;
                modelo.Dificuldade = questao.Dificuldade;
                modelo.TipoQuestao = questao.TipoQuestao;
                modelo.Visibilidade = questao.Visibilidade;
                modelo.Bloom = questao.Bloom;
                modelo.Origem = questao.Origem;
                modelo.Ano = questao.Ano;
                modelo.Referencia = questao.Referencia;
                modelo.SecaoEnade = questao.SecaoEnade;
                modelo.NumeroOriginal = questao.NumeroOriginal;
                modelo.CodigoProvaOrigem = questao.CodigoProvaOrigem;
                modelo.Explicacao = questao.Explicacao;
                modelo.Tags = questao.Tags.Select(t => t.Nome).OrderBy(n => n).ToList();
                modelo.Ativa = questao.Ativa;
                // Contexto transitório de UI, inferido do Curso do primeiro Item PPC
                // já vinculado (senão ele ficaria fora do checklist na edição).
                modelo.CursoContextoMatrizId = questao.ItensMatriz
                    .Select(i => i.MatrizReferencia?.CursoId)
                    .FirstOrDefault(id => id is not null);
                modelo.AreaCursoIds = questao.AreasCurso.Select(a => a.Id).ToList();
                itemMatrizIdsSelecionados = questao.ItensMatriz.Select(i => i.Id).ToHashSet();
                // Detalhe completo (sem filtro de Ativo/Status) dos itens já vinculados.
                detalhesItensSelecionados = questao.ItensMatriz.ToDictionary(i => i.Id);
                if (modelo.CursoContextoMatrizId is int cursoDaQuestao)
                {
                    await CarregarItensDoCursoAsync(cursoDaQuestao);
                }
                if (modelo.AreaCursoIds.Count > 0)
                {
                    await CarregarItensDasAreasAsync();
                }
                imagensExistentes = questao.Imagens.OrderBy(i => i.Ordem).ToList();
                historico = await QuestaoHistoricoService.ObterHistoricoAsync(Id.Value, meuId, minhaInstituicaoId);
                qualidade = QualidadeQuestao.Calcular(questao);

                switch (questao)
                {
                    case QuestaoMultiplaEscolha me:
                        var ordenadas = me.Alternativas.OrderBy(a => a.Letra).ToList();
                        modelo.Alternativas = ordenadas.Select(a => new AlternativaInput { Texto = a.Texto }).ToList();
                        while (modelo.Alternativas.Count < 2)
                        {
                            modelo.Alternativas.Add(new AlternativaInput());
                        }
                        modelo.RespostaCorretaIndex = Math.Max(0, ordenadas.FindIndex(a => a.Letra == me.RespostaCorreta));
                        break;
                    case QuestaoDiscursiva d:
                        modelo.RespostaEsperada = d.RespostaEsperada;
                        modelo.CriterioAvaliacao = d.CriterioAvaliacao;
                        break;
                    case QuestaoCertoErrado c:
                        modelo.RespostaCorretaCE = c.RespostaCorreta;
                        break;
                    case QuestaoAssociacao assoc:
                        modelo.Pares = assoc.Pares.OrderBy(p => p.Ordem)
                            .Select(p => new ParAssociacaoInput { Termo = p.Termo, Correspondente = p.Correspondente })
                            .ToList();
                        while (modelo.Pares.Count < 2)
                        {
                            modelo.Pares.Add(new ParAssociacaoInput());
                        }
                        break;
                    case QuestaoRespostaBreve rb:
                        modelo.RespostaBreveEsperada = rb.RespostaEsperada;
                        break;
                    case QuestaoNumerica num:
                        modelo.NumericaEsperada = num.RespostaEsperada;
                        modelo.NumericaTolerancia = num.Tolerancia;
                        break;
                    case QuestaoLacunas lac:
                        modelo.Lacunas = lac.Lacunas.OrderBy(l => l.Ordem)
                            .Select(l => new LacunaInput { RespostaEsperada = l.RespostaEsperada })
                            .ToList();
                        if (modelo.Lacunas.Count == 0)
                        {
                            modelo.Lacunas.Add(new LacunaInput());
                        }
                        break;
                }
            }
            catch (OperacaoInvalidaException ex)
            {
                erro = ex.Message;
                acessoNegado = true;
            }
        }
        else
        {
            // Consumir() só devolve algo se o professor acabou de clicar "Usar esta
            // questão" em QuestaoGerarIa; abrir manualmente não reaplica um rascunho antigo.
            var pendente = RascunhoIa.Consumir();
            if (pendente is not null)
            {
                modelo = pendente.Value.Rascunho;
                disciplinaId = pendente.Value.DisciplinaId;
            }
        }

        carregando = false;
    }

    // Reprocessa fórmulas (MathJax) a cada render, inclusive as do "oninput" do
    // enunciado; fica aqui porque o JS localiza por id no DOM final da página.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrWhiteSpace(modelo.Enunciado))
        {
            await JS.InvokeVoidAsync("bqTypesetMath", "preview-enunciado");
        }
        if (!string.IsNullOrWhiteSpace(modelo.Explicacao))
        {
            await JS.InvokeVoidAsync("bqTypesetMath", "preview-explicacao");
        }
    }

    private bool salvando;

    private async Task SalvarAsync()
    {
        if (salvando)
        {
            return;
        }

        erro = null;
        resumoErros = 0;
        modelo.ItemMatrizIds = itemMatrizIdsSelecionados.ToList();

        salvando = true;
        try
        {
            if (Id is null)
            {
                await QuestaoService.CriarAsync(modelo, pendentes, meuId, minhaInstituicaoId);
            }
            else
            {
                await QuestaoService.AtualizarAsync(Id.Value, modelo, imagensExistentes, imagensParaRemover, pendentes, meuId, minhaInstituicaoId);
            }

            NavigationManager.NavigateTo($"questoes?msg={Uri.EscapeDataString("✓ Questão salva com sucesso.")}");
        }
        catch (OperacaoInvalidaException ex)
        {
            erro = ex.Message;
        }
        finally
        {
            salvando = false;
        }
    }

    // Esses DTOs moram em Services/QuestaoInput.cs, ao lado de quem os valida.
}
