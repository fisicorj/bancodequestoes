@page "/disciplinas"
@attribute [Authorize]
@rendermode InteractiveServer
@inject DisciplinaService DisciplinaService
@inject IJSRuntime JS

<PageTitle>Disciplinas</PageTitle>

<h1>Disciplinas</h1>

<p>
    <a class="btn btn-primary" href="disciplinas/novo">+ Nova disciplina</a>
</p>

@if (sucesso is not null)
{
    <div class="alert alert-success">@sucesso</div>
}

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}

<div class="row g-2 align-items-end mb-3 p-3 bg-light border rounded">
    <div class="col-12 col-md-6">
        <label class="form-label small mb-1">Buscar por nome</label>
        <input type="text" class="form-control" placeholder="Digite para buscar..."
               @bind="filtroTexto" @bind:event="oninput" @bind:after="AplicarFiltroAsync" />
    </div>
    <div class="col-6 col-md-2">
        <button type="button" class="btn btn-sm btn-outline-secondary w-100" @onclick="LimparFiltroAsync">Limpar</button>
    </div>
</div>

@if (disciplinas is null)
{
    <p><em>Carregando...</em></p>
}
else if (disciplinas.Count == 0)
{
    <p><em>Nenhuma disciplina encontrada com os filtros atuais.</em></p>
}
else
{
    <p class="text-muted small">
        Mostrando @((pagina - 1) * TamanhoPagina + 1)–@((pagina - 1) * TamanhoPagina + disciplinas.Count) de @totalRegistros disciplina(s).
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Assuntos</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in disciplinas)
            {
                <tr>
                    <td>@d.Nome</td>
                    <td>@d.Assuntos.Count</td>
                    <td>
                        <a class="btn btn-sm btn-secondary" href="@($"disciplinas/editar/{d.Id}")">Editar</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarExcluirAsync(d)">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Paginacao Pagina="pagina" TamanhoPagina="TamanhoPagina" TotalRegistros="totalRegistros" PaginaChanged="MudarPaginaAsync" />
}

@code {
    private List<Disciplina>? disciplinas;
    private string? erro;
    private string? sucesso;

    private string filtroTexto = "";

    private const int TamanhoPagina = 20;
    private int pagina = 1;
    private int totalRegistros;

    [SupplyParameterFromQuery(Name = "msg")]
    private string? Msg { get; set; }

    protected override async Task OnInitializedAsync()
    {
        sucesso = Msg;
        await CarregarAsync();
    }

    private async Task AplicarFiltroAsync()
    {
        pagina = 1;
        await CarregarAsync();
    }

    private async Task LimparFiltroAsync()
    {
        filtroTexto = "";
        pagina = 1;
        await CarregarAsync();
    }

    private async Task MudarPaginaAsync(int novaPagina)
    {
        pagina = novaPagina;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        var resultado = await DisciplinaService.ListarAsync(filtroTexto, pagina, TamanhoPagina);
        disciplinas = resultado.Itens;
        totalRegistros = resultado.Total;
    }

    private async Task ConfirmarExcluirAsync(Disciplina d)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Excluir a disciplina \"{d.Nome}\"? Essa ação não pode ser desfeita.");
        if (confirmado)
        {
            await ExcluirAsync(d);
        }
    }

    private async Task ExcluirAsync(Disciplina d)
    {
        erro = null;
        sucesso = null;
        try
        {
            await DisciplinaService.ExcluirAsync(d);
            sucesso = $"\"{d.Nome}\" excluída com sucesso.";
            await CarregarAsync();
        }
        catch (OperacaoInvalidaException ex)
        {
            erro = ex.Message;
        }
    }
}
