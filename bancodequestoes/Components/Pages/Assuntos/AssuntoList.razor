@page "/assuntos"
@attribute [Authorize]
@rendermode InteractiveServer
@inject DisciplinaService DisciplinaService
@inject IJSRuntime JS

<PageTitle>Assuntos</PageTitle>

<PageHeader Titulo="Assuntos">
    <Acao>
        <a class="btn btn-primary" href="assuntos/novo">+ Novo assunto</a>
    </Acao>
</PageHeader>

@if (sucesso is not null)
{
    <div class="alert alert-success">@sucesso</div>
}

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}

<div class="row g-2 align-items-end mb-3 p-3 bg-light border rounded">
    <div class="col-12 col-md-6">
        <label class="form-label small mb-1">Buscar por nome</label>
        <input type="text" class="form-control" placeholder="Digite para buscar..."
               @bind="filtroTexto" @bind:event="oninput" @bind:after="AplicarFiltroAsync" />
    </div>
    <div class="col-8 col-md-4">
        <label class="form-label small mb-1">Disciplina</label>
        <select class="form-select" @bind="filtroDisciplinaId" @bind:after="AplicarFiltroAsync">
            <option value="0">Todas</option>
            @foreach (var d in disciplinas)
            {
                <option value="@d.Id">@d.Nome</option>
            }
        </select>
    </div>
    <div class="col-4 col-md-2">
        <button type="button" class="btn btn-sm btn-outline-secondary w-100" @onclick="LimparFiltrosAsync">Limpar</button>
    </div>
</div>

@if (assuntos is null)
{
    <p><em>Carregando...</em></p>
}
else if (assuntos.Count == 0)
{
    <p><em>Nenhum assunto encontrado com os filtros atuais.</em></p>
}
else
{
    <p class="text-muted small">
        Mostrando @((pagina - 1) * TamanhoPagina + 1)–@((pagina - 1) * TamanhoPagina + assuntos.Count) de @totalRegistros assunto(s).
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Disciplina</th>
                <th>Questões</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in assuntos)
            {
                <tr>
                    <td>@a.Nome</td>
                    <td>@a.Disciplina?.Nome</td>
                    <td>@a.Questoes.Count</td>
                    <td>
                        <a class="btn btn-sm btn-secondary" href="@($"assuntos/editar/{a.Id}")">Editar</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarExcluirAsync(a)">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Paginacao Pagina="pagina" TamanhoPagina="TamanhoPagina" TotalRegistros="totalRegistros" PaginaChanged="MudarPaginaAsync" />
}

@code {
    private List<Assunto>? assuntos;
    private List<Disciplina> disciplinas = new();
    private string? erro;
    private string? sucesso;

    private string filtroTexto = "";
    private int filtroDisciplinaId;

    private const int TamanhoPagina = 20;
    private int pagina = 1;
    private int totalRegistros;

    [SupplyParameterFromQuery(Name = "msg")]
    private string? Msg { get; set; }

    protected override async Task OnInitializedAsync()
    {
        sucesso = Msg;
        disciplinas = await DisciplinaService.ListarTodasAsync();
        await CarregarAsync();
    }

    private async Task AplicarFiltroAsync()
    {
        pagina = 1;
        await CarregarAsync();
    }

    private async Task LimparFiltrosAsync()
    {
        filtroTexto = "";
        filtroDisciplinaId = 0;
        pagina = 1;
        await CarregarAsync();
    }

    private async Task MudarPaginaAsync(int novaPagina)
    {
        pagina = novaPagina;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        var resultado = await DisciplinaService.ListarAssuntosAsync(filtroTexto, filtroDisciplinaId, pagina, TamanhoPagina);
        assuntos = resultado.Itens;
        totalRegistros = resultado.Total;
    }

    private async Task ConfirmarExcluirAsync(Assunto a)
    {
        // a.Questoes já vem carregado (Include em ListarAssuntosAsync) — mostra a contagem
        // aqui porque, com a FK Restrict, excluir com Questões vinculadas vai falhar mesmo;
        // melhor o professor já saber antes de clicar do que só ver o erro depois.
        var aviso = a.Questoes.Count > 0
            ? $"Excluir o assunto \"{a.Nome}\"? Ele tem {a.Questoes.Count} questão(ões) vinculada(s) — a exclusão será recusada até elas serem movidas ou excluídas."
            : $"Excluir o assunto \"{a.Nome}\"? Essa ação não pode ser desfeita.";
        var confirmado = await JS.InvokeAsync<bool>("confirm", aviso);
        if (confirmado)
        {
            await ExcluirAsync(a);
        }
    }

    private async Task ExcluirAsync(Assunto a)
    {
        erro = null;
        sucesso = null;
        try
        {
            await DisciplinaService.ExcluirAssuntoAsync(a);
            sucesso = $"\"{a.Nome}\" excluído com sucesso.";
            await CarregarAsync();
        }
        catch (OperacaoInvalidaException ex)
        {
            erro = ex.Message;
        }
    }
}
