<!--
    Card "Dados da prova" no topo de ProvaForm.razor, extraido de la.

    NAO tem EditForm proprio - eh renderizado dentro do EditForm que ja
    existe em ProvaForm.razor, entao os componentes Input* abaixo recebem o
    EditContext em cascata normalmente (cascading parameters atravessam
    fronteira de componente sem problema nenhum).

    Continua "burro": Modelo eh a MESMA instancia de ProvaInput que
    ProvaForm guarda (referencia compartilhada), entao os campos com bind
    direto (Data da aplicacao, Titulo, Observacoes - nenhum "depois"
    associado la no arquivo original) simplesmente mutam esse objeto e ficam
    guardados, sem precisar de EventCallback nenhum: nada FORA deste
    componente le esses tres campos.

    Ja os campos que no arquivo original disparavam algo em ProvaForm
    (Curso/Turma/Disciplina recarregam o banco de questoes; Tipo/Ano/
    Semestre/Bimestre reajustam o titulo sugerido) continuam chamando de
    volta pra ProvaForm via EventCallback - inclusive Tempo estimado, que no
    original NAO tinha "depois" nenhum (nao precisava, era tudo o mesmo
    componente), mas agora precisa: o card "Resumo da prova" (outro
    componente irmao, ver ResumoProva.razor) mostra esse valor, entao sem
    avisar ProvaForm ele ficaria com o numero antigo ate outra interacao
    qualquer forcar um re-render.
-->

<div class="form-card mb-3">
    <div class="row">
        <div class="col-md-6">
            <div class="form-floating">
                <InputSelect @bind-Value="Modelo.CursoId" id="CursoId" class="form-select" @bind-Value:after="MudarCurso">
                    <option value="0">Nenhum (sem cabeçalho de instituição)</option>
                    @foreach (var c in Cursos)
                    {
                        <option value="@c.Id">@c.Instituicao?.Nome / @c.Nome</option>
                    }
                </InputSelect>
                <label for="CursoId">Curso (para o cabeçalho da exportação)</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating">
                <InputSelect @bind-Value="Modelo.TurmaId" id="TurmaId" class="form-select" @bind-Value:after="MudarTurma">
                    <option value="0">Nenhuma</option>
                    @foreach (var t in TurmasDoCurso)
                    {
                        <option value="@t.Id">@t.Rotulo — @t.Disciplina?.Nome</option>
                    }
                </InputSelect>
                <label for="TurmaId">Turma</label>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <div class="form-floating">
                <InputSelect @bind-Value="Modelo.DisciplinaId" id="DisciplinaId" class="form-select" @bind-Value:after="MudarDisciplina">
                    <option value="0">Selecione...</option>
                    @foreach (var d in Disciplinas)
                    {
                        <option value="@d.Id">@d.Nome</option>
                    }
                </InputSelect>
                <label for="DisciplinaId">Disciplina</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-floating">
                <InputSelect @bind-Value="Modelo.Tipo" id="Tipo" class="form-select" @bind-Value:after="AtualizarTitulo">
                    <option value="">Não informado</option>
                    @foreach (var t in Enum.GetValues<TipoProva>())
                    {
                        <option value="@t">@t.Rotulo()</option>
                    }
                </InputSelect>
                <label for="Tipo">Tipo</label>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-3">
            <div class="form-floating">
                <InputNumber @bind-Value="Modelo.Ano" id="Ano" class="form-control" placeholder="Ano" @bind-Value:after="AtualizarTitulo" />
                <label for="Ano">Ano</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-floating">
                <InputSelect @bind-Value="Modelo.Semestre" id="Semestre" class="form-select" @bind-Value:after="AtualizarTitulo">
                    <option value="">—</option>
                    <option value="1">1º semestre</option>
                    <option value="2">2º semestre</option>
                </InputSelect>
                <label for="Semestre">Semestre</label>
            </div>
        </div>
        @if (PrecisaBimestre)
        {
            <div class="col-md-3">
                <div class="form-floating">
                    <InputSelect @bind-Value="Modelo.Bimestre" id="Bimestre" class="form-select" @bind-Value:after="AtualizarTitulo">
                        <option value="">—</option>
                        <option value="1">1º bimestre</option>
                        <option value="2">2º bimestre</option>
                    </InputSelect>
                    <label for="Bimestre">Bimestre</label>
                </div>
            </div>
        }
        <div class="col-md-3">
            <div class="form-floating">
                <InputDate @bind-Value="Modelo.DataAplicacao" id="DataAplicacao" class="form-control" />
                <label for="DataAplicacao">Data da aplicação</label>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-12">
            <div class="form-floating">
                <InputText @bind-Value="Modelo.Titulo" id="Titulo" class="form-control" placeholder="Título" />
                <label for="Titulo">Título</label>
            </div>
            <span class="text-muted small">Sugerido automaticamente a partir de Curso/Disciplina/Tipo/Período — edite à vontade.</span>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-3">
            <div class="form-floating">
                <InputNumber @bind-Value="Modelo.TempoEstimadoMinutos" id="TempoEstimadoMinutos" class="form-control" placeholder="Tempo" @bind-Value:after="Alterado" />
                <label for="TempoEstimadoMinutos">Tempo estimado (min)</label>
            </div>
        </div>
        <div class="col-md-9">
            <div class="form-floating">
                <InputTextArea @bind-Value="Modelo.Observacoes" id="Observacoes" class="form-control" placeholder="Observações" style="height: 58px;" />
                <label for="Observacoes">Observações</label>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProvaInput Modelo { get; set; } = null!;
    [Parameter] public List<Curso> Cursos { get; set; } = new();
    [Parameter] public List<Disciplina> Disciplinas { get; set; } = new();
    [Parameter] public List<Turma> TurmasDoCurso { get; set; } = new();
    [Parameter] public bool PrecisaBimestre { get; set; }

    [Parameter] public EventCallback OnMudarCurso { get; set; }
    [Parameter] public EventCallback OnMudarTurma { get; set; }
    [Parameter] public EventCallback OnMudarDisciplina { get; set; }
    [Parameter] public EventCallback OnAtualizarTitulo { get; set; }
    [Parameter] public EventCallback OnAlterado { get; set; }

    private Task MudarCurso() => OnMudarCurso.InvokeAsync();
    private Task MudarTurma() => OnMudarTurma.InvokeAsync();
    private Task MudarDisciplina() => OnMudarDisciplina.InvokeAsync();
    private Task AtualizarTitulo() => OnAtualizarTitulo.InvokeAsync();
    private Task Alterado() => OnAlterado.InvokeAsync();
}
