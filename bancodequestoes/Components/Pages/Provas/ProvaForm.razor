@page "/provas/novo"
@page "/provas/editar/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@using BancoQuestoes.Components.Pages.Provas.Components
@inject ProvaService ProvaService
@inject GeradorProvaService GeradorProvaService
@inject QuestaoQueryService QuestaoQueryService
@inject DisciplinaService DisciplinaService
@inject CursoService CursoService
@inject MatrizReferenciaService MatrizService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>@(Id is null ? "Nova prova" : "Editar prova")</PageTitle>

<PageHeader Titulo="@(Id is null ? "Nova prova" : "Editar prova")"
            Subtitulo="Configure os dados, escolha como montar e selecione as questões." />

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}

@if (carregando)
{
    <p><em>Carregando...</em></p>
}
else if (acessoNegado)
{
    <p><a href="provas">Voltar para provas</a></p>
}
else if (disciplinas.Count == 0)
{
    <p><em>Cadastre uma disciplina antes de montar uma prova.</em> <a href="disciplinas/novo">Criar disciplina</a></p>
}
else
{
    <EditForm Model="modelo" OnValidSubmit="SalvarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <h2 class="section-title mb-3">Configuração inicial</h2>

        <DadosProva Modelo="modelo"
                    Cursos="cursos"
                    TurmasDoCurso="TurmasDoCurso"
                    PrecisaBimestre="PrecisaBimestre"
                    OnMudarCurso="AoMudarCurso"
                    OnMudarTurma="AoMudarTurmaAsync"
                    OnAtualizarTitulo="AtualizarSugestaoTitulo"
                    OnAlterado="NotificarMudanca" />

        <EscopoProvaSelector Modelo="modelo"
                              Disciplinas="disciplinas"
                              MatrizesDoCurso="matrizesDoCurso"
                              OnMudarTipoEscopo="AoMudarEscopoAsync"
                              OnMudarDisciplina="AoMudarDisciplinaAsync"
                              OnMudarComposicao="AoMudarComposicaoEscopoAsync"
                              OnMudarMatriz="AoMudarMatrizAsync" />

        @if (EscopoPossuiSelecaoValida)
        {
            <h2 class="section-title mb-3 mt-4">Montagem da prova</h2>

            @if (modo == ModoMontagem.NaoEscolhido)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h3 class="section-subtitle mb-3">Como deseja montar esta prova?</h3>
                        <div class="modo-montagem-opcoes">
                            <button type="button" class="modo-montagem-card" @onclick="EscolherModoAutomaticoAsync">
                                <span class="modo-montagem-card-icone" aria-hidden="true">✨</span>
                                <span class="modo-montagem-card-titulo">Gerar automaticamente</span>
                                <span class="modo-montagem-card-desc">O sistema escolhe as questões seguindo os critérios que você definir.</span>
                            </button>
                            <button type="button" class="modo-montagem-card" @onclick="() => modo = ModoMontagem.Manual">
                                <span class="modo-montagem-card-icone" aria-hidden="true">✋</span>
                                <span class="modo-montagem-card-titulo">Montar manualmente</span>
                                <span class="modo-montagem-card-desc">Você escolhe cada questão do banco.</span>
                            </button>
                            <div class="modo-montagem-card modo-montagem-card-em-breve">
                                <span class="modo-montagem-card-icone" aria-hidden="true">📋</span>
                                <span class="modo-montagem-card-titulo">Usar prova anterior como modelo</span>
                                <span class="modo-montagem-card-desc">Em breve.</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="mb-2">
                    <button type="button" class="btn btn-sm btn-link px-0" @onclick="() => modo = ModoMontagem.NaoEscolhido">← Trocar modo de montagem</button>
                </p>

                @if (modo == ModoMontagem.Automatico)
                {
                    <GeradorAutomatico Dados="MontarDadosGerador()" />
                }
                else
                {
                    <FiltrosQuestoes @bind-FiltroAssuntoId="filtroAssuntoId" AssuntosDisponiveis="assuntosDisponiveis" OnAlterado="AplicarFiltro" />
                }

                <div class="row">
                    @if (modo == ModoMontagem.Manual)
                    {
                        <div class="col-md-6">
                            <BancoQuestoesSelector QuestoesFiltradas="questoesFiltradas"
                                                   Selecionadas="selecionadas"
                                                   UsosPorQuestao="usosPorQuestaoDisponiveis"
                                                   OnVisualizar="AbrirPreview"
                                                   OnAdicionar="Adicionar" />
                        </div>
                    }
                    <div id="questoes-selecionadas" class="@(modo == ModoMontagem.Manual ? "col-md-6" : "col-md-12")">
                        <QuestoesSelecionadas Selecionadas="selecionadas"
                                              QuestoesPorId="questoesPorId"
                                              AvisoSubstituicao="avisoSubstituicao"
                                              Arrastando="arrastando"
                                              OnDragStart="IniciarArrasto"
                                              OnDrop="SoltarSobre"
                                              OnVisualizar="AbrirPreview"
                                              OnSubstituir="Substituir"
                                              OnRemover="Remover" />
                    </div>
                </div>

                @if (selecionadas.Count > 0)
                {
                    <!-- Resumo vivo, visível nos dois modos (Etapa 3 UX/UI item 10) -
                         so leitura de dados ja calculados (selecionadas, tempo
                         estimado), nenhum metodo novo em ProvaForm. -->
                    <div class="resumo-prova-sticky mb-3">
                        <span><strong>@selecionadas.Count</strong> questão(ões)</span>
                        <span class="resumo-prova-sticky-sep">·</span>
                        <span><strong>@(selecionadas.Sum(s => s.Valor ?? 0).ToString("0.##"))</strong> ponto(s)</span>
                        @if (modelo.TempoEstimadoMinutos is { } tempoEstimadoResumo && tempoEstimadoResumo > 0)
                        {
                            <span class="resumo-prova-sticky-sep">·</span>
                            <span>~<strong>@tempoEstimadoResumo</strong> min estimados</span>
                        }
                    </div>
                }

                @* "Distribuição por disciplina" (item 44 do pedido) — card separado
                   da "Cobertura Curricular" (dentro de GeradorAutomatico, acima) de
                   propósito: são dois conceitos diferentes (origem disciplinar real
                   das questões x cobertura de competências/conteúdos), nunca
                   misturados na mesma tabela — vale especialmente pro modo
                   Curso/ENADE, onde os dois relatórios coexistem. *@
                @if (modelo.TipoEscopo != TipoEscopoProva.Disciplina && selecionadas.Count > 0)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <h6 class="card-title">Distribuição por disciplina</h6>
                            @{ var distribuicaoPorDisciplina = CalcularDistribuicaoPorDisciplina(); }
                            @if (distribuicaoPorDisciplina.Count == 0)
                            {
                                <p class="text-muted small mb-0"><em>Nenhuma questão selecionada tem disciplina identificável.</em></p>
                            }
                            else
                            {
                                <ul class="mb-0">
                                    @foreach (var linha in distribuicaoPorDisciplina.Values)
                                    {
                                        <li>@linha</li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }

                @if (selecionadas.Count > 0)
                {
                    <PontuacaoProva @bind-ValorTotal="gerador.ValorTotal"
                                    @bind-ModoPontuacao="modoPontuacao"
                                    AvisoPontuacao="@avisoPontuacao"
                                    OnAplicar="AplicarPontuacao"
                                    OnAlterado="NotificarMudanca" />
                }
            }
        }

        <button type="submit" class="btn btn-primary" disabled="@salvando">
            @(salvando ? "Salvando..." : "Salvar prova")
        </button>
        <a href="provas" class="btn btn-link">Cancelar</a>
    </EditForm>
}

<QuestaoPreviewModal QuestaoAtual="questaoPreview"
                     JaSelecionada="questaoPreview is not null && selecionadas.Any(s => s.QuestaoId == questaoPreview.Id)"
                     UsosDaQuestao="questaoPreview is null ? 0 : usosPorQuestaoDisponiveis.GetValueOrDefault(questaoPreview.Id)"
                     OnFechar="FecharPreview"
                     OnAdicionar="AdicionarDoPreview" />

