@page "/provas/novo"
@page "/provas/editar/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using BancoQuestoes.Exportacao
@using BancoQuestoes.Components.Pages.Provas.Components
@inject ProvaService ProvaService
@inject DisciplinaService DisciplinaService
@inject CursoService CursoService
@inject MatrizReferenciaService MatrizService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>@(Id is null ? "Nova prova" : "Editar prova")</PageTitle>

<h1>@(Id is null ? "Nova prova" : "Editar prova")</h1>

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}

@if (carregando)
{
    <p><em>Carregando...</em></p>
}
else if (acessoNegado)
{
    <p><a href="provas">Voltar para provas</a></p>
}
else if (disciplinas.Count == 0)
{
    <p><em>Cadastre uma disciplina antes de montar uma prova.</em> <a href="disciplinas/novo">Criar disciplina</a></p>
}
else
{
    <EditForm Model="modelo" OnValidSubmit="SalvarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <DadosProva Modelo="modelo"
                    Cursos="cursos"
                    Disciplinas="disciplinas"
                    TurmasDoCurso="TurmasDoCurso"
                    PrecisaBimestre="PrecisaBimestre"
                    OnMudarCurso="AoMudarCurso"
                    OnMudarTurma="AoMudarTurmaAsync"
                    OnMudarDisciplina="AoMudarDisciplinaAsync"
                    OnAtualizarTitulo="AtualizarSugestaoTitulo"
                    OnAlterado="NotificarMudanca" />

        @if (modelo.DisciplinaId != 0)
        {
            @if (modo == ModoMontagem.NaoEscolhido)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Como deseja montar a prova?</h5>
                        <div class="d-flex flex-wrap gap-3 mt-3">
                            <button type="button" class="btn btn-outline-primary text-start p-3" style="width: 280px;" @onclick="EscolherModoAutomaticoAsync">
                                <div class="fs-5 mb-1">✨ Gerar automaticamente</div>
                                <div class="small text-muted">O sistema escolhe as questões seguindo os critérios que você definir.</div>
                            </button>
                            <button type="button" class="btn btn-outline-primary text-start p-3" style="width: 280px;" @onclick="() => modo = ModoMontagem.Manual">
                                <div class="fs-5 mb-1">✋ Montar manualmente</div>
                                <div class="small text-muted">Você escolhe cada questão do banco.</div>
                            </button>
                            <div class="text-start p-3 border rounded text-muted" style="width: 280px; opacity: 0.65;">
                                <div class="fs-5 mb-1">📋 Usar prova anterior como modelo</div>
                                <div class="small">Em breve.</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="mb-2">
                    <button type="button" class="btn btn-sm btn-link px-0" @onclick="() => modo = ModoMontagem.NaoEscolhido">← Trocar modo de montagem</button>
                </p>

                @if (modo == ModoMontagem.Automatico)
                {
                    <GeradorAutomatico Gerador="gerador"
                                       Diagnostico="CalcularDiagnostico()"
                                       FaceisQtd="QuantidadePorDificuldade(Dificuldade.Facil)"
                                       MediasQtd="QuantidadePorDificuldade(Dificuldade.Media)"
                                       DificeisQtd="QuantidadePorDificuldade(Dificuldade.Dificil)"
                                       TotalPercDificuldade="TotalPercDificuldade"
                                       AssuntosDisponiveis="assuntosDisponiveis"
                                       PercPorAssuntoGerador="percPorAssuntoGerador"
                                       DisponiveisPorAssunto="DisponiveisPorAssunto"
                                       QuantidadePorAssunto="QuantidadePorAssunto"
                                       TotalPercAssuntos="TotalPercAssuntos"
                                       AvisosDisponibilidade="AvisosDisponibilidade()"
                                       TiposPermitidosAtuais="TiposPermitidosAtuais()"
                                       DisponiveisPorTipo="DisponiveisPorTipo"
                                       QuantidadePorTipoGerador="quantidadePorTipoGerador"
                                       SomaQuantidadePorTipo="SomaQuantidadePorTipo"
                                       AvisosPorTipo="AvisosPorTipo()"
                                       PercPorBloomGerador="percPorBloomGerador"
                                       TotalPercBloom="TotalPercBloom"
                                       QuantidadeQualidadeAtende="QuantidadeQualidadeAtende()"
                                       TempoMinutos="modelo.TempoEstimadoMinutos"
                                       ResumoConteudo="ResumoConteudoBlueprint()"
                                       TiposTexto="TiposPermitidosTexto()"
                                       AvisoGerador="avisoGerador"
                                       SelecionadasCount="selecionadas.Count"
                                       Aderencia="CalcularAderenciaBlueprint()"
                                       ItensCurricular="itensCurricularProva"
                                       DisponiveisPorItem="DisponiveisPorItem"
                                       CoberturaCurricular="CalcularCoberturaCurricular()"
                                       DisponiveisDistintasSelecionadas="DisponiveisDistintasParaConjunto()"
                                       PercPorItemGerador="percPorItemGerador"
                                       QtdPlanejadaPorItemBlueprint="QtdPlanejadaPorItemBlueprint()"
                                       BlueprintCurricularViavel="BlueprintCurricularViavel()"
                                       AvisosBlueprintCurricular="AvisosBlueprintCurricular()"
                                       AderenciaBlueprintCurricular="CalcularAderenciaBlueprintCurricular()"
                                       AderenciaBlueprintCurricularPercentual="AderenciaBlueprintCurricularPercentual()"
                                       OnAlternarItemBlueprint="args => AlternarItemBlueprint(args.ItemId, args.Marcado)"
                                       OnAlterado="NotificarMudanca"
                                       OnAlternarAssunto="args => AlternarAssuntoGerador(args.AssuntoId, args.Marcado)"
                                       OnSincronizarQuantidadePorTipo="SincronizarQuantidadePorTipo"
                                       OnAlternarDefinirQuantidadePorTipo="AoAlternarDefinirQuantidadePorTipo"
                                       OnAlternarBloom="args => AlternarBloomGerador(args.Nivel, args.Marcado)"
                                       OnAtualizarDiagnosticoRecentes="AtualizarDiagnosticoRecentesAsync"
                                       OnGerar="GerarProvaAsync"
                                       OnAdicionarPeloGerador="AdicionarPeloGeradorAsync" />
                }
                else
                {
                    <FiltrosQuestoes @bind-FiltroAssuntoId="filtroAssuntoId" AssuntosDisponiveis="assuntosDisponiveis" OnAlterado="AplicarFiltro" />
                }

                <div class="row">
                    @if (modo == ModoMontagem.Manual)
                    {
                        <div class="col-md-6">
                            <BancoQuestoesSelector QuestoesFiltradas="questoesFiltradas"
                                                   Selecionadas="selecionadas"
                                                   UsosPorQuestao="usosPorQuestaoDisponiveis"
                                                   OnVisualizar="AbrirPreview"
                                                   OnAdicionar="Adicionar" />
                        </div>
                    }
                    <div class="@(modo == ModoMontagem.Manual ? "col-md-6" : "col-md-12")">
                        <QuestoesSelecionadas Selecionadas="selecionadas"
                                              QuestoesPorId="questoesPorId"
                                              AvisoSubstituicao="avisoSubstituicao"
                                              Arrastando="arrastando"
                                              OnDragStart="IniciarArrasto"
                                              OnDrop="SoltarSobre"
                                              OnVisualizar="AbrirPreview"
                                              OnSubstituir="Substituir"
                                              OnRemover="Remover" />
                    </div>
                </div>

                @if (selecionadas.Count > 0)
                {
                    <PontuacaoProva @bind-ValorTotal="gerador.ValorTotal"
                                    @bind-ModoPontuacao="modoPontuacao"
                                    AvisoPontuacao="avisoPontuacao"
                                    OnAplicar="AplicarPontuacao"
                                    OnAlterado="NotificarMudanca" />
                }
            }
        }

        <button type="submit" class="btn btn-primary">Salvar</button>
        <a href="provas" class="btn btn-link">Cancelar</a>
    </EditForm>
}

<QuestaoPreviewModal QuestaoAtual="questaoPreview"
                     JaSelecionada="questaoPreview is not null && selecionadas.Any(s => s.QuestaoId == questaoPreview.Id)"
                     UsosDaQuestao="questaoPreview is null ? 0 : usosPorQuestaoDisponiveis.GetValueOrDefault(questaoPreview.Id)"
                     OnFechar="FecharPreview"
                     OnAdicionar="AdicionarDoPreview" />

@code {
    [Parameter]
    public int? Id { get; set; }

    private ProvaInput modelo = new();
    private List<Disciplina> disciplinas = new();
    private List<Curso> cursos = new();
    private List<Turma> todasTurmas = new();
    private List<Assunto> assuntosDisponiveis = new();

    // Blueprint de avaliação: chave = AssuntoId/NivelBloom, valor = % da
    // Quantidade que deve vir dali. PercPorAssunto precisa ter pelo menos uma
    // chave e somar 100 (validado em ProvaService.Sortear); PercPorBloom pode
    // ficar vazio (= não filtrar por Bloom), mas se tiver algo também precisa
    // somar 100.
    private Dictionary<int, int> percPorAssuntoGerador = new();
    private Dictionary<NivelBloom, int> percPorBloomGerador = new();

    // Alinhamento Curricular / ENADE (opcional/avançado) — itens (flat, de
    // todas as matrizes vinculáveis) do Curso escolhido na prova
    // (modelo.CursoId), recarregados toda vez que ele muda (ver AoMudarCurso).
    private List<ItemMatrizReferencia> itensCurricularProva = new();

    // Blueprint Curricular (item 2 da 2ª rodada de revisão) — chave =
    // ItemMatrizReferenciaId, valor = % da Quantidade que deve vir daquele
    // item. Só usado quando Gerador.ModoAlinhamentoCurricular ==
    // BlueprintCurricular; mesmo raciocínio de percPorAssuntoGerador acima
    // (Dictionary de tamanho variável, não cabe dentro de GeradorInput).
    private Dictionary<int, int> percPorItemGerador = new();
    // niveisBloom (Enum.GetValues<NivelBloom>()) foi movido pra dentro de
    // GeradorAutomatico.razor — só era usado lá.

    private int TotalPercAssuntos => percPorAssuntoGerador.Values.Sum();
    private int TotalPercBloom => percPorBloomGerador.Values.Sum();

    // Soma dos % de Dificuldade digitados — só calcula a distribuição em
    // Questões quando isso fechar 100 (senão os números ficariam sem sentido
    // no meio da digitação, tipo "Fácil: 50%" sem Média/Difícil ainda
    // preenchidos apontando 0 questões).
    private int TotalPercDificuldade => gerador.PercFacil + gerador.PercMedia + gerador.PercDificil;

    // Quantas questões de cada Dificuldade o gerador vai buscar, dado o %
    // atual — reaproveita o mesmíssimo algoritmo (maior resto) do sorteio de
    // verdade, pra prévia na tela nunca divergir do resultado real.
    private int QuantidadePorDificuldade(Dificuldade nivel)
    {
        if (TotalPercDificuldade != 100)
        {
            return 0;
        }

        var percentuais = new Dictionary<Dificuldade, int>
        {
            [Dificuldade.Facil] = gerador.PercFacil,
            [Dificuldade.Media] = gerador.PercMedia,
            [Dificuldade.Dificil] = gerador.PercDificil,
        };
        return ProvaService.DistribuirPorPercentual(percentuais, gerador.Quantidade).GetValueOrDefault(nivel);
    }

    // Lista de tipos marcados no gerador — usada tanto pra prévia de
    // "Disponíveis" na tabela de Assuntos quanto pelo sorteio de verdade
    // (SortearQuestoesAsync), pra nunca divergir entre as duas.
    private List<TipoQuestao> TiposPermitidosAtuais()
    {
        var tipos = new List<TipoQuestao>();
        if (gerador.PermiteMultiplaEscolha) tipos.Add(TipoQuestao.MultiplaEscolha);
        if (gerador.PermiteDiscursiva) tipos.Add(TipoQuestao.Discursiva);
        if (gerador.PermiteCertoErrado) tipos.Add(TipoQuestao.CertoErrado);
        if (gerador.PermiteAssociacao) tipos.Add(TipoQuestao.Associacao);
        if (gerador.PermiteRespostaBreve) tipos.Add(TipoQuestao.RespostaBreve);
        if (gerador.PermiteNumerica) tipos.Add(TipoQuestao.Numerica);
        if (gerador.PermiteLacunas) tipos.Add(TipoQuestao.Lacunas);
        return tipos;
    }

    // Quantas questões desse Assunto existem no banco (já filtradas pelos
    // tipos marcados E pela qualidade mínima do gerador) — é o "Disponíveis"
    // da tabela, base do aviso de firewall quando o % pedido passa disso.
    private int DisponiveisPorAssunto(int assuntoId)
    {
        var tiposPermitidos = TiposPermitidosAtuais();
        return PoolQualificado().Count(q => q.AssuntoId == assuntoId && tiposPermitidos.Contains(q.TipoQuestao));
    }

    // Pool depois do filtro de qualidade mínima (item 6), SEM ainda o filtro
    // de item de matriz — separado de PoolQualificado() abaixo porque
    // DisponiveisPorItem precisa contar UM item de cada vez, sem que o
    // filtro de item (que usa esse mesmo Alinhamento Curricular) esconda o
    // próprio item que está sendo contado.
    private List<Questao> PoolPorQualidade() => gerador.QualidadeMinima == QualidadeMinima.Qualquer
        ? questoesDisponiveis
        : questoesDisponiveis.Where(q => QualidadeQuestao.Calcular(q).Percentual >= gerador.QualidadeMinima.PercentualMinimo()).ToList();

    // Pool de candidatas depois do filtro de qualidade mínima (item 6) E do
    // Modo FiltroCurricular do Alinhamento Curricular (item 1/2 da 2ª rodada
    // de revisão) — vazio quando Modo é SemMatriz/BlueprintCurricular, ou
    // quando FiltroCurricular está ativo mas nada foi marcado (não filtra
    // nada, é o pool inteiro). Usado tanto pra calcular "Disponíveis" nas
    // tabelas quanto como entrada de verdade pro sorteio (ver
    // SortearQuestoesAsync), pra nunca prometer mais do que o sorteio de
    // fato consegue entregar. Itens são flat (sem hierarquia), então,
    // diferente do antigo modelo de Diretriz, não precisa expandir
    // descendentes.
    //
    // Modo BlueprintCurricular NÃO filtra aqui de propósito: a alocação por
    // item nesse modo é feita inteira dentro de
    // ProvaService.SortearPorBlueprintCurricular (que já olha ItensMatriz de
    // cada questão sozinho) — filtrar o pool aqui também seria redundante.
    private List<Questao> PoolQualificado()
    {
        var pool = PoolPorQualidade();

        if (gerador.ModoAlinhamentoCurricular != ModoAlinhamentoCurricular.FiltroCurricular || gerador.ItemMatrizIdsDesejados.Count == 0)
        {
            return pool;
        }

        return pool.Where(q => q.ItensMatriz.Any(i => gerador.ItemMatrizIdsDesejados.Contains(i.Id))).ToList();
    }

    // Conjunto de itens "em jogo" no momento, seja qual for o Modo — Filtro
    // usa o HashSet de sempre (Gerador.ItemMatrizIdsDesejados); Blueprint usa
    // as chaves de percPorItemGerador (quem tem % marcado); SemMatriz não
    // tem nenhum. Centraliza essa escolha pra CalcularCoberturaCurricular e
    // o diagnóstico de disponibilidade não precisarem repetir o switch cada
    // um.
    private HashSet<int> ItensCurricularSelecionados() => gerador.ModoAlinhamentoCurricular switch
    {
        ModoAlinhamentoCurricular.FiltroCurricular => gerador.ItemMatrizIdsDesejados,
        ModoAlinhamentoCurricular.BlueprintCurricular => percPorItemGerador.Keys.ToHashSet(),
        _ => new HashSet<int>(),
    };

    // "Questões distintas disponíveis para o conjunto selecionado" (item 4/5
    // do pedido) — NÃO é a soma de DisponiveisPorItem de cada item (que
    // superestima quando os mesmos itens compartilham questão, ex.: C08 e
    // CT20 nas mesmas 10 questões) — é a contagem de questões (cada uma
    // contada UMA vez) que batem com PELO MENOS UM item do conjunto.
    private int DisponiveisDistintasParaConjunto()
    {
        var ids = ItensCurricularSelecionados();
        if (ids.Count == 0)
        {
            return 0;
        }

        var tiposPermitidos = TiposPermitidosAtuais();
        return PoolPorQualidade().Count(q => tiposPermitidos.Contains(q.TipoQuestao) && q.ItensMatriz.Any(i => ids.Contains(i.Id)));
    }

    // Diagnóstico pré-geração (item 8 do pedido): "C1 — 24 questões
    // disponíveis" — conta sobre o pool já filtrado por tipo/qualidade
    // (PoolPorQualidade), mas SEM aplicar o filtro de item do gerador, senão
    // marcar outro item mudaria a contagem deste.
    private int DisponiveisPorItem(int itemId)
    {
        var tiposPermitidos = TiposPermitidosAtuais();
        return PoolPorQualidade().Count(q => tiposPermitidos.Contains(q.TipoQuestao) && q.ItensMatriz.Any(i => i.Id == itemId));
    }

    // "Cobertura Curricular" pós-geração (item 9 do pedido): quantas das
    // questões atualmente em "selecionadas" atendem cada item marcado —
    // calculado AO VIVO a partir de "selecionadas" (mesmo espírito de
    // CalcularAderenciaBlueprint), então reflete ajustes manuais feitos
    // depois do sorteio, não só o resultado congelado no momento de gerar.
    private List<LinhaCoberturaItem> CalcularCoberturaCurricular()
    {
        var idsSelecionados = ItensCurricularSelecionados();
        if (idsSelecionados.Count == 0 || selecionadas.Count == 0)
        {
            return new();
        }

        var questoesSelecionadas = selecionadas
            .Select(s => questoesPorId.GetValueOrDefault(s.QuestaoId))
            .Where(q => q is not null)
            .Select(q => q!)
            .ToList();

        var resultado = new List<LinhaCoberturaItem>();
        foreach (var id in idsSelecionados)
        {
            var item = itensCurricularProva.FirstOrDefault(i => i.Id == id);
            if (item is null)
            {
                continue;
            }

            var qtd = questoesSelecionadas.Count(q => q.ItensMatriz.Any(i => i.Id == id));
            resultado.Add(new LinhaCoberturaItem { Item = item, Quantidade = qtd });
        }

        return resultado.OrderBy(x => x.Item.Codigo).ToList();
    }

    // --- Blueprint Curricular: diagnóstico + Planejado × Obtido (itens 5/6 do pedido) ---

    // Simula a MESMA alocação gulosa "mais raro primeiro" de
    // ProvaService.SortearPorBlueprintCurricular, mas sem sortear de fato
    // (Take em vez de SortearAleatorios) — só pra saber, ANTES de clicar em
    // Gerar, se cada item vai bater a cota (item 5 do pedido: "diagnóstico
    // antes de gerar"). Como pegar os N primeiros de um conjunto de tamanho
    // >= N sempre funciona, a resposta "dá ou não dá" é a mesma do sorteio
    // de verdade — só MUDA quais questões especificamente seriam escolhidas
    // dentro da cota, o que não importa pra essa pergunta de viabilidade.
    private (bool Possivel, Dictionary<int, int> FaltandoPorItem) SimularViabilidadeBlueprint()
    {
        if (percPorItemGerador.Count == 0 || gerador.Quantidade <= 0)
        {
            return (false, new());
        }

        var qtdPlanejada = ProvaService.DistribuirPorPercentual(percPorItemGerador, gerador.Quantidade);
        var tiposPermitidos = TiposPermitidosAtuais();
        var pool = PoolQualificado().Where(q => tiposPermitidos.Contains(q.TipoQuestao)).ToList();

        var alocadas = new HashSet<int>(selecionadas.Select(s => s.QuestaoId));
        var faltando = new Dictionary<int, int>();

        var ordemItens = qtdPlanejada
            .Where(kv => kv.Value > 0)
            .OrderBy(kv => pool.Count(q => !alocadas.Contains(q.Id) && q.ItensMatriz.Any(i => i.Id == kv.Key)))
            .Select(kv => kv.Key);

        foreach (var itemId in ordemItens)
        {
            var qtd = qtdPlanejada[itemId];
            var disponiveis = pool.Where(q => !alocadas.Contains(q.Id) && q.ItensMatriz.Any(i => i.Id == itemId)).Take(qtd).ToList();
            foreach (var q in disponiveis)
            {
                alocadas.Add(q.Id);
            }
            if (disponiveis.Count < qtd)
            {
                faltando[itemId] = qtd - disponiveis.Count;
            }
        }

        return (faltando.Count == 0, faltando);
    }

    // "Resultado: Planejado × Obtido" (item 6 do pedido) — igual espírito de
    // CalcularCoberturaCurricular acima: calculado AO VIVO sobre
    // "selecionadas", com a MESMA regra de "cada questão só ocupa uma
    // posição" que o sorteio de verdade usa (senão o resumo divergiria do
    // que foi realmente alocado quando uma questão selecionada toca vários
    // itens do blueprint — item 3 do pedido).
    private List<LinhaBlueprintCurricular> CalcularAderenciaBlueprintCurricular()
    {
        if (gerador.ModoAlinhamentoCurricular != ModoAlinhamentoCurricular.BlueprintCurricular
            || percPorItemGerador.Count == 0 || selecionadas.Count == 0)
        {
            return new();
        }

        var qtdPlanejada = ProvaService.DistribuirPorPercentual(percPorItemGerador, gerador.Quantidade);

        var questoesSelecionadas = selecionadas
            .Select(s => questoesPorId.GetValueOrDefault(s.QuestaoId))
            .Where(q => q is not null)
            .Select(q => q!)
            .ToList();

        var alocadas = new HashSet<int>();
        var obtidoPorItem = new Dictionary<int, int>();

        var ordemItens = qtdPlanejada
            .Where(kv => kv.Value > 0)
            .OrderBy(kv => questoesSelecionadas.Count(q => !alocadas.Contains(q.Id) && q.ItensMatriz.Any(i => i.Id == kv.Key)))
            .Select(kv => kv.Key);

        foreach (var itemId in ordemItens)
        {
            var disponiveis = questoesSelecionadas
                .Where(q => !alocadas.Contains(q.Id) && q.ItensMatriz.Any(i => i.Id == itemId))
                .Take(qtdPlanejada[itemId])
                .ToList();
            foreach (var q in disponiveis)
            {
                alocadas.Add(q.Id);
            }
            obtidoPorItem[itemId] = disponiveis.Count;
        }

        return qtdPlanejada
            .Where(kv => kv.Value > 0)
            .Select(kv => new { ItemId = kv.Key, Item = itensCurricularProva.FirstOrDefault(i => i.Id == kv.Key), Planejada = kv.Value })
            .Where(x => x.Item is not null)
            .Select(x => new LinhaBlueprintCurricular
            {
                Item = x.Item!,
                PercentualPlanejado = percPorItemGerador.GetValueOrDefault(x.ItemId),
                QuantidadePlanejada = x.Planejada,
                QuantidadeObtida = obtidoPorItem.GetValueOrDefault(x.ItemId),
            })
            .OrderBy(l => l.Item.Codigo)
            .ToList();
    }

    // "Aderência ao blueprint: X%" (item 23 do pedido) — fórmula explícita
    // (o pedido pede pra não inventar uma fórmula arbitrária sem documentar):
    // soma do Obtido de cada item dividido pela soma do Planejado de cada
    // item, em %. Como o algoritmo nunca aloca MAIS que o planejado por item,
    // essa fração nunca passa de 100%.
    private int AderenciaBlueprintCurricularPercentual()
    {
        var linhas = CalcularAderenciaBlueprintCurricular();
        if (linhas.Count == 0)
        {
            return 0;
        }

        var totalPlanejado = linhas.Sum(l => l.QuantidadePlanejada);
        if (totalPlanejado == 0)
        {
            return 0;
        }

        return (int)Math.Round(100.0 * linhas.Sum(l => l.QuantidadeObtida) / totalPlanejado);
    }

    // Quantidade planejada por item, ao vivo, pra tabela do Modo Blueprint
    // Curricular mostrar a coluna "Questões" enquanto o professor ainda está
    // digitando percentuais — mesma conta que o sorteio de verdade usa
    // (ProvaService.DistribuirPorPercentual), sem duplicar o algoritmo.
    private Dictionary<int, int> QtdPlanejadaPorItemBlueprint() =>
        percPorItemGerador.Count == 0 ? new() : ProvaService.DistribuirPorPercentual(percPorItemGerador, gerador.Quantidade);

    private bool BlueprintCurricularViavel() => SimularViabilidadeBlueprint().Possivel;

    // Mensagens de aviso do diagnóstico pré-geração do Blueprint Curricular
    // (item 5 do pedido) — uma por item que não teria questões suficientes,
    // com o mesmo código/título já usado no resto da tela.
    private List<string> AvisosBlueprintCurricular()
    {
        if (gerador.ModoAlinhamentoCurricular != ModoAlinhamentoCurricular.BlueprintCurricular || percPorItemGerador.Count == 0)
        {
            return new();
        }

        var (possivel, faltando) = SimularViabilidadeBlueprint();
        if (possivel)
        {
            return new();
        }

        return faltando
            .OrderByDescending(kv => kv.Value)
            .Select(kv =>
            {
                var item = itensCurricularProva.FirstOrDefault(i => i.Id == kv.Key);
                var rotulo = item is null ? $"item #{kv.Key}" : $"{item.Codigo} — {item.Titulo}";
                return $"{rotulo}: faltam {kv.Value} questão(ões) pra bater a cota planejada.";
            })
            .ToList();
    }

    // Inclui/remove um item da tabela do Blueprint Curricular — entra com 0%
    // (o professor ajusta em seguida), sai completamente do dicionário
    // (diferente do Modo Filtro, que usa HashSet — aqui precisa ser
    // Dictionary porque cada item marcado carrega um percentual).
    private void AlternarItemBlueprint(int itemId, bool marcado)
    {
        if (marcado)
        {
            if (!percPorItemGerador.ContainsKey(itemId))
            {
                percPorItemGerador[itemId] = 0;
            }
        }
        else
        {
            percPorItemGerador.Remove(itemId);
        }
    }

    // Quantas questões (do pool já qualificado) atendem ao limiar de
    // qualidade atual — mostrado ao lado dos radios de qualidade mínima
    // (item 6), escopado aos tipos/assuntos já marcados no blueprint.
    private int QuantidadeQualidadeAtende() => PoolDiagnostico().Count(q =>
        QualidadeQuestao.Calcular(q).Percentual >= gerador.QualidadeMinima.PercentualMinimo());

    // Pool "elegível" pro diagnóstico do banco (item 5): candidatas da
    // disciplina já restritas aos tipos e assuntos marcados no blueprint,
    // SEM aplicar ainda o filtro de qualidade mínima — o diagnóstico é
    // informativo sobre TUDO que existe (inclusive quantas têm qualidade
    // baixa), não sobre o que sobra depois de filtrar.
    private List<Questao> PoolDiagnostico() => questoesDisponiveis
        .Where(q => TiposPermitidosAtuais().Contains(q.TipoQuestao) && percPorAssuntoGerador.ContainsKey(q.AssuntoId))
        .ToList();

    // Estatísticas do "diagnóstico do banco" (item 5) — mostrado antes do
    // professor clicar em gerar, pra ele ver de cara se o blueprint que
    // montou tem lastro no banco de questões ou não.
    private DiagnosticoBanco CalcularDiagnostico()
    {
        var pool = PoolDiagnostico();
        return new DiagnosticoBanco
        {
            Total = pool.Count,
            Faceis = pool.Count(q => q.Dificuldade == Dificuldade.Facil),
            Medias = pool.Count(q => q.Dificuldade == Dificuldade.Media),
            Dificeis = pool.Count(q => q.Dificuldade == Dificuldade.Dificil),
            UsadasRecentemente = pool.Count(q => idsRecentesDiagnostico.Contains(q.Id)),
            SemBloom = pool.Count(q => q.Bloom is null),
            QualidadeBaixa = pool.Count(q => QualidadeQuestao.Calcular(q).Percentual < 50),
            // Aproximação, não um solver de verdade: considera o blueprint
            // atendível quando os percentuais fecham 100% e nenhum firewall
            // (por assunto, e por tipo quando ativo) já apontou falta de
            // questões numa célula específica.
            BlueprintAtendivel = TotalPercAssuntos == 100
                && TotalPercDificuldade == 100
                && AvisosDisponibilidade().Count == 0
                && (!gerador.DefinirQuantidadePorTipo || (SomaQuantidadePorTipo == gerador.Quantidade && AvisosPorTipo().Count == 0)),
        };
    }

    // Aderência ao blueprint (item 15): compara Planejado (% configurado) com
    // Obtido (% de verdade nas "selecionadas" atuais) por Dificuldade e por
    // Assunto — sempre calculado AO VIVO a partir de "selecionadas" (não
    // "congelado" no momento do sorteio), então reflete a composição real
    // mesmo se o professor ajustar a lista manualmente depois de gerar.
    // Tolerância de 1 ponto percentual porque arredondamento de poucas
    // questões em percentuais raramente bate exato.
    private List<LinhaAderencia> CalcularAderenciaBlueprint()
    {
        var linhas = new List<LinhaAderencia>();
        if (selecionadas.Count == 0)
        {
            return linhas;
        }

        var questoesSelecionadas = selecionadas.Select(s => questoesPorId[s.QuestaoId]).ToList();
        var total = questoesSelecionadas.Count;

        if (TotalPercDificuldade == 100)
        {
            foreach (var (nivel, planejado) in new[]
            {
                (Dificuldade.Facil, gerador.PercFacil),
                (Dificuldade.Media, gerador.PercMedia),
                (Dificuldade.Dificil, gerador.PercDificil),
            })
            {
                var qtd = questoesSelecionadas.Count(q => q.Dificuldade == nivel);
                linhas.Add(new LinhaAderencia
                {
                    Rotulo = nivel.Rotulo(),
                    PlanejadoPercentual = planejado,
                    ObtidoPercentual = (int)Math.Round(100.0 * qtd / total),
                    ObtidoQuantidade = qtd,
                });
            }
        }

        if (TotalPercAssuntos == 100)
        {
            foreach (var (assuntoId, planejado) in percPorAssuntoGerador)
            {
                var nome = assuntosDisponiveis.FirstOrDefault(a => a.Id == assuntoId)?.Nome ?? $"assunto #{assuntoId}";
                var qtd = questoesSelecionadas.Count(q => q.AssuntoId == assuntoId);
                linhas.Add(new LinhaAderencia
                {
                    Rotulo = nome,
                    PlanejadoPercentual = planejado,
                    ObtidoPercentual = (int)Math.Round(100.0 * qtd / total),
                    ObtidoQuantidade = qtd,
                });
            }
        }

        return linhas;
    }

    // LinhaAderencia virou tipo top-level em Services/GeradorInput.cs — ver
    // comentário lá.

    // Tipo | Disponíveis | Quantidade (item 7): quanto o "Definir quantidade
    // por tipo" estiver marcado, cada tipo permitido vira uma cota exata em
    // vez de só "pode usar" — ver o loop por tipo em SortearQuestoesAsync.
    private Dictionary<TipoQuestao, int> quantidadePorTipoGerador = new();

    private int DisponiveisPorTipo(TipoQuestao tipo) =>
        PoolQualificado().Count(q => q.TipoQuestao == tipo && percPorAssuntoGerador.ContainsKey(q.AssuntoId));

    private int SomaQuantidadePorTipo => quantidadePorTipoGerador.Values.Sum();

    // Mantém as chaves de quantidadePorTipoGerador em dia com os checkboxes
    // de Tipo marcados — chamado no @bind:after de cada checkbox de tipo, pra
    // a tabela nunca mostrar (ou perder) um tipo fora de sincronia com o que
    // está de fato permitido.
    private void SincronizarQuantidadePorTipo()
    {
        if (!gerador.DefinirQuantidadePorTipo)
        {
            return;
        }

        var tipos = TiposPermitidosAtuais();
        foreach (var tipo in tipos.Where(t => !quantidadePorTipoGerador.ContainsKey(t)))
        {
            quantidadePorTipoGerador[tipo] = 0;
        }
        foreach (var tipo in quantidadePorTipoGerador.Keys.Where(t => !tipos.Contains(t)).ToList())
        {
            quantidadePorTipoGerador.Remove(tipo);
        }
    }

    // Ao ligar "Definir quantidade por tipo" pela primeira vez, começa com a
    // Quantidade total dividida igualmente entre os tipos permitidos — mesmo
    // espírito de "Todos os assuntos começam marcados... com % dividido
    // igualmente" em CarregarQuestoesDisponiveisAsync, o professor ajusta a
    // partir de um ponto de partida razoável em vez de do zero.
    private void AoAlternarDefinirQuantidadePorTipo()
    {
        if (!gerador.DefinirQuantidadePorTipo || quantidadePorTipoGerador.Count > 0)
        {
            return;
        }

        quantidadePorTipoGerador = DividirQuantidadeIgualmente(TiposPermitidosAtuais(), gerador.Quantidade);
    }

    // Igual a DividirIgualmente, mas divide uma QUANTIDADE inteira (não um
    // percentual de 100) igualmente entre chaves, com o resto nas primeiras —
    // só usado pra dar um ponto de partida razoável na tabela de tipos.
    private static Dictionary<TipoQuestao, int> DividirQuantidadeIgualmente(List<TipoQuestao> tipos, int quantidade)
    {
        var resultado = new Dictionary<TipoQuestao, int>();
        if (tipos.Count == 0)
        {
            return resultado;
        }

        var baseQtd = quantidade / tipos.Count;
        var resto = quantidade - baseQtd * tipos.Count;
        for (var i = 0; i < tipos.Count; i++)
        {
            resultado[tipos[i]] = baseQtd + (i < resto ? 1 : 0);
        }
        return resultado;
    }

    // Mesmo "firewall" de AvisosDisponibilidade, só que por Tipo em vez de
    // Assunto — só roda quando a distribuição por tipo está ativa.
    private List<string> AvisosPorTipo()
    {
        var avisos = new List<string>();
        if (!gerador.DefinirQuantidadePorTipo)
        {
            return avisos;
        }

        foreach (var (tipo, qtd) in quantidadePorTipoGerador)
        {
            var disponiveis = DisponiveisPorTipo(tipo);
            if (qtd > disponiveis)
            {
                avisos.Add($"{tipo.Rotulo()}: solicitado {qtd}, disponíveis {disponiveis}.");
            }
        }
        return avisos;
    }

    // Quantas questões desse Assunto o gerador vai buscar, dado o % atual —
    // mesma lógica de QuantidadePorDificuldade, só que pra Assuntos.
    private int QuantidadePorAssunto(int assuntoId)
    {
        if (TotalPercAssuntos != 100 || gerador.Quantidade <= 0)
        {
            return 0;
        }

        return ProvaService.DistribuirPorPercentual(percPorAssuntoGerador, gerador.Quantidade).GetValueOrDefault(assuntoId);
    }

    // "Criptografia 3 · Firewall 2 · ..." pro card de resumo do blueprint
    // (item 9) — string pronta pra Razor não precisar de uma expressão C#
    // multilinha dentro de @string.Join(...) na marcação.
    private string ResumoConteudoBlueprint() => string.Join(" · ", percPorAssuntoGerador.Keys.Select(id =>
        $"{assuntosDisponiveis.FirstOrDefault(a => a.Id == id)?.Nome ?? "?"} {QuantidadePorAssunto(id)}"));

    // Extraído como método (em vez de escrever a expressão direto no atributo
    // do componente ResumoProva) porque a expressão original usa aspas
    // (" · ") — dentro de um valor de atributo Razor, que já é delimitado por
    // aspas, isso fecharia o atributo cedo. Passar só a CHAMADA do método
    // evita esse problema.
    private string TiposPermitidosTexto() => string.Join(" · ", TiposPermitidosAtuais().Select(t => t.Rotulo()));

    // Avisos de "firewall": assuntos onde a quantidade pedida (pelo %) passa
    // do que está disponível no banco — mostrados como alerta antes do
    // professor sortear, pra não levar uma surpresa de menos questões do que
    // pediu.
    private List<string> AvisosDisponibilidade()
    {
        var avisos = new List<string>();
        if (TotalPercAssuntos != 100)
        {
            return avisos;
        }

        foreach (var (assuntoId, _) in percPorAssuntoGerador)
        {
            var qtd = QuantidadePorAssunto(assuntoId);
            var disponiveis = DisponiveisPorAssunto(assuntoId);
            if (qtd > disponiveis)
            {
                var nome = assuntosDisponiveis.FirstOrDefault(a => a.Id == assuntoId)?.Nome ?? $"assunto #{assuntoId}";
                avisos.Add($"{nome}: solicitado {qtd}, disponíveis {disponiveis}.");
            }
        }
        return avisos;
    }

    // DiagnosticoBanco (item 5) virou tipo top-level em
    // Services/GeradorInput.cs — ver comentário lá.

    private List<Questao> questoesDisponiveis = new();
    private List<Questao> questoesFiltradas = new();
    private Dictionary<int, Questao> questoesPorId = new();
    private List<QuestaoSelecionada> selecionadas = new();
    private int filtroAssuntoId;
    private bool carregando;
    private string? erro;
    private bool acessoNegado;
    private string? meuId;
    private int? minhaInstituicaoId;

    // Quantas vezes cada questão disponível já foi usada em provas —
    // carregado uma vez junto com questoesDisponiveis e reaproveitado tanto
    // pelos cards da lista manual (item 11) quanto pelo sorteio automático
    // (SortearQuestoesAsync), em vez de consultar o banco de novo a cada
    // clique em "Gerar prova".
    private Dictionary<int, int> usosPorQuestaoDisponiveis = new();

