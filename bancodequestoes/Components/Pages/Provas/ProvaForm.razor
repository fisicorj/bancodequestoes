    // mesmo com "Evitar questões recentes" desmarcado, é só informativo até o
    // professor decidir ligar o filtro de verdade. Recalculado quando entra
    // no modo Automático ou quando o critério/valor de "recentes" muda.
    private HashSet<int> idsRecentesDiagnostico = new();

    // Questão aberta no modal "Visualizar" (item 12) — sempre uma das já
    // carregadas em questoesPorId (com Alternativas/Pares/Lacunas já
    // populadas por ObterAssuntosEQuestoesDisponiveisAsync), então não
    // precisa de uma consulta nova só pra abrir o modal.
    private Questao? questaoPreview;

    private GeradorInput gerador = new();
    private string? avisoGerador;

    // Como a prova vai ser montada — escolhido numa telinha própria assim que
    // a Disciplina é definida, pra não empilhar o card do gerador E a busca
    // manual na mesma tela (poluição visual). "UsarModelo" ainda não existe
    // de verdade — é só o botão desabilitado ("em breve") no seletor.
    private enum ModoMontagem { NaoEscolhido, Automatico, Manual }
    private ModoMontagem modo = ModoMontagem.NaoEscolhido;

    // Bloco "Pontuação" (item 16) — como distribuir o Valor da prova entre as
    // questões selecionadas. MesmoValor é o comportamento antigo (equivalente
