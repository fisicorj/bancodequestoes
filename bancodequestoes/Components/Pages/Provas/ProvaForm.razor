    private ModoPontuacao modoPontuacao = ModoPontuacao.MesmoValor;
    private string? avisoPontuacao;

    // Último título que NÓS sugerimos (Tipo — Disciplina — Curso — Período).
    // Enquanto modelo.Titulo continuar igual a isso (ou vazio), continuamos
    // atualizando sozinhos a cada mudança de Curso/Turma/Disciplina/Tipo/
    // Ano/Semestre/Bimestre. No instante em que o professor digita algo
    // diferente, paramos de mexer — a sugestão não pode atropelar uma edição manual.
    private string? tituloAutoSugerido;

    // Último DisciplinaId efetivamente carregado — ver AoMudarDisciplinaAsync.
    private int disciplinaIdAnterior;

    // Restringe as opções de Turma ao Curso já escolhido — evita listar turmas
    // de outros cursos que nunca fariam sentido pra essa prova. Sem Curso
    // escolhido ainda, mostra todas (o professor pode escolher a Turma primeiro).
    private List<Turma> TurmasDoCurso => modelo.CursoId == 0
        ? todasTurmas
        : todasTurmas.Where(t => t.CursoId == modelo.CursoId).ToList();

    // cursos já vem com .Instituicao incluída (CursoService.ListarTodosAsync)
    // — dá pra decidir se mostra o campo Bimestre sem consulta extra. Ao
    // contrário de Turma, aqui não é obrigatório escolher (Semestre já é
    // metadado solto em Prova hoje, Bimestre segue a mesma informalidade).
    private bool PrecisaBimestre =>
        cursos.FirstOrDefault(c => c.Id == modelo.CursoId)?.Instituicao?.SistemaPeriodos == SistemaPeriodos.SemestralComBimestres;

    protected override async Task OnInitializedAsync()
    {
        carregando = true;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        meuId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        minhaInstituicaoId = await ProvaService.ObterInstituicaoDoUsuarioAsync(meuId);

        disciplinas = await DisciplinaService.ListarTodasAsync();
        cursos = await CursoService.ListarTodosAsync();
        todasTurmas = await CursoService.ListarTodasTurmasAsync();

        if (Id is not null)
        {
            var prova = await ProvaService.CarregarComQuestoesAsync(Id.Value);

            if (prova is null)
            {
                erro = "Prova não encontrada.";
                acessoNegado = true;
            }
            else if (prova.CriadoPorId != meuId)
            {
                // Provas são privadas: só quem criou pode ver/editar/apagar a sua.
                erro = "Você não tem permissão para editar esta prova.";
                acessoNegado = true;
            }
            else
            {
                modelo.Titulo = prova.Titulo;
                modelo.DisciplinaId = prova.DisciplinaId;
                modelo.CursoId = prova.CursoId ?? 0;
                modelo.TurmaId = prova.TurmaId ?? 0;
                await CarregarItensDoCursoProvaAsync();
                modelo.Tipo = prova.Tipo;
                modelo.Ano = prova.Ano;
                modelo.Semestre = prova.Semestre;
                modelo.Bimestre = prova.Bimestre;
                modelo.DataAplicacao = prova.DataAplicacao;
                modelo.TempoEstimadoMinutos = prova.TempoEstimadoMinutos;
                modelo.Observacoes = prova.Observacoes;

                await CarregarQuestoesDisponiveisAsync();

                foreach (var pq in prova.ProvaQuestoes.OrderBy(pq => pq.Ordem))
                {
                    if (pq.Questao is not null)
                    {
                        questoesPorId[pq.Questao.Id] = pq.Questao;
                    }
                    selecionadas.Add(new QuestaoSelecionada
                    {
                        QuestaoId = pq.QuestaoId,
                        Ordem = pq.Ordem,
                        Valor = pq.Valor,
                    });
                }

                // Editar uma prova já existente é sempre um ajuste na lista que já
                // foi montada — pular direto pro modo manual evita reapresentar a
                // telinha de escolha de modo pra algo que já foi decidido antes.
                // O professor ainda pode trocar pra "Gerar automaticamente" se
                // quiser complementar a lista via sorteio.
                modo = ModoMontagem.Manual;
            }
        }

        carregando = false;
    }

    private async Task CarregarQuestoesDisponiveisAsync()
    {
        selecionadas.Clear();

        var (assuntos, questoes) = await ProvaService.ObterAssuntosEQuestoesDisponiveisAsync(modelo.DisciplinaId, meuId, minhaInstituicaoId);
        assuntosDisponiveis = assuntos;
        questoesDisponiveis = questoes;

        foreach (var q in questoesDisponiveis)
        {
            questoesPorId[q.Id] = q;
        }

        // Todos os assuntos começam marcados no gerador, com % dividido
        // igualmente entre eles — o professor ajusta o que quiser a partir
        // daí, em vez de começar do zero preenchendo tudo manualmente.
        percPorAssuntoGerador = DividirIgualmente(assuntosDisponiveis.Select(a => a.Id).ToList());

        usosPorQuestaoDisponiveis = await ProvaService.ContarUsosAsync(questoesDisponiveis.Select(q => q.Id).ToList());
        await AtualizarDiagnosticoRecentesAsync();

        filtroAssuntoId = 0;
        AplicarFiltro();

        AtualizarSugestaoTitulo();

        // Último valor de Disciplina efetivamente carregado — referência pra
        // AoMudarDisciplinaAsync/AoMudarTurmaAsync saberem pra qual valor
        // voltar se o professor desistir da troca depois do aviso de
        // confirmação (ver ConfirmarLimpezaSelecaoAsync).
        disciplinaIdAnterior = modelo.DisciplinaId;
    }

    // Trocar de Disciplina descarta o banco de questões carregado (outra
    // matéria = outras questões) e, com ele, a seleção atual — perigoso se o
    // professor já tinha montado várias questões e mexeu no combo por
    // engano. Confirma antes de proceder; se ele desistir, volta o <select>
    // pro valor anterior (o two-way bind já tinha empurrado o novo valor pra
    // modelo.DisciplinaId antes desse método rodar, por isso o "desfazer"
    // aqui é necessário, não automático).
    private async Task AoMudarDisciplinaAsync()
    {
        if (!await ConfirmarLimpezaSelecaoAsync())
        {
            modelo.DisciplinaId = disciplinaIdAnterior;
            return;
        }

        await CarregarQuestoesDisponiveisAsync();
    }

    // Mesmo aviso de AoMudarDisciplinaAsync, reaproveitado por quem mais
    // dispara uma limpeza de "selecionadas" ao trocar de Disciplina (hoje só
    // AoMudarTurmaAsync, quando a Turma escolhida implica outra Disciplina).
    // Sem risco (lista vazia), não incomoda o professor com um pop-up à toa.
    private async Task<bool> ConfirmarLimpezaSelecaoAsync()
    {
        if (selecionadas.Count == 0)
        {
            return true;
        }

        return await JS.InvokeAsync<bool>("confirm",
            $"Alterar a disciplina removerá as {selecionadas.Count} questões atualmente selecionadas. Deseja continuar?");
    }

    // Carrega/recarrega os ids "usados recentemente" pro diagnóstico do banco
    // — mesmo cálculo de ProvaService.ObterIdsRecentesAsync usado no sorteio
    // de verdade (ver SortearQuestoesAsync), só que disparado antecipadamente
    // (ao trocar de disciplina, entrar no modo Automático, ou mudar o
    // critério/valor de "recentes"), pra alimentar o card de diagnóstico
    // mesmo antes do professor clicar em gerar.
    private async Task AtualizarDiagnosticoRecentesAsync()
    {
        idsRecentesDiagnostico = await ProvaService.ObterIdsRecentesAsync(meuId, gerador.CriterioRecentes, gerador.ValorCriterioRecentes);
    }

    // Entrar no modo Automático já atualiza o diagnóstico de "usadas
    // recentemente" na hora, sem esperar o professor mexer em algum campo —
    // senão o card de diagnóstico apareceria com "0 usadas recentemente"
    // (valor inicial) até a primeira mudança de critério.
    private async Task EscolherModoAutomaticoAsync()
    {
        modo = ModoMontagem.Automatico;
        await AtualizarDiagnosticoRecentesAsync();
    }

    // "P1 — Engenharia de Software — ADS — 2º semestre/2026" — junta só as
    // partes que já têm valor (não precisa de tudo preenchido pra sugerir
    // algo útil). Só mexe em modelo.Titulo enquanto ele ainda for igual à
    // ÚLTIMA sugestão nossa (ou estiver vazio) — ver o comentário em
    // tituloAutoSugerido.
    private void AtualizarSugestaoTitulo()
    {
        if (!string.IsNullOrWhiteSpace(modelo.Titulo) && modelo.Titulo != tituloAutoSugerido)
        {
            return;
        }

        var partes = new List<string>();

        if (modelo.Tipo is { } tipo)
        {
            partes.Add(tipo.Rotulo());
        }

        var disciplina = disciplinas.FirstOrDefault(d => d.Id == modelo.DisciplinaId)?.Nome;
        if (!string.IsNullOrWhiteSpace(disciplina))
        {
            partes.Add(disciplina);
        }

        var curso = cursos.FirstOrDefault(c => c.Id == modelo.CursoId)?.Nome;
        if (!string.IsNullOrWhiteSpace(curso))
        {
            partes.Add(curso);
        }

        var periodo = FormatarPeriodo();
        if (periodo is not null)
        {
            partes.Add(periodo);
        }

        tituloAutoSugerido = partes.Count == 0 ? null : string.Join(" — ", partes);
        modelo.Titulo = tituloAutoSugerido ?? "";
    }

    // "2º bimestre/2026", "1º semestre/2026" ou só "2026" — Bimestre tem
    // prioridade sobre Semestre quando os dois estão preenchidos (é a
    // informação mais específica). Sem nenhum dos dois, mas com Ano, mostra
    // só o ano; sem nada, não entra no título.
    private string? FormatarPeriodo()
    {
        var parte = modelo.Bimestre is { } bimestre
            ? $"{bimestre}º bimestre"
            : modelo.Semestre is { } semestre
                ? $"{semestre}º semestre"
                : null;

        if (parte is null)
        {
            return modelo.Ano?.ToString();
        }

        return modelo.Ano is { } ano ? $"{parte}/{ano}" : parte;
    }

    // Divide 100% igualmente entre "chaves" itens, com o resto do
    // arredondamento nas primeiras chaves — só usado pra dar um ponto de
    // partida razoável no gerador; ProvaService.DistribuirPorPercentual (o
    // "maior resto" de verdade) é quem decide a alocação final na hora do
    // sorteio, esse aqui é só o valor inicial mostrado na tela.
    private static Dictionary<int, int> DividirIgualmente(List<int> chaves)
    {
        var resultado = new Dictionary<int, int>();
        if (chaves.Count == 0)
        {
            return resultado;
        }

        var basePct = 100 / chaves.Count;
        var resto = 100 - basePct * chaves.Count;
        for (var i = 0; i < chaves.Count; i++)
        {
            resultado[chaves[i]] = basePct + (i < resto ? 1 : 0);
        }
        return resultado;
    }

    private void AlternarAssuntoGerador(int assuntoId, bool marcado)
    {
        if (marcado)
        {
            percPorAssuntoGerador[assuntoId] = 0;
        }
        else
        {
            percPorAssuntoGerador.Remove(assuntoId);
        }
    }

    private void AlternarBloomGerador(NivelBloom nivel, bool marcado)
    {
        if (marcado)
        {
            percPorBloomGerador[nivel] = 0;
        }
        else
        {
            percPorBloomGerador.Remove(nivel);
        }
    }

    // Escolher uma Turma implica Curso e Disciplina — preenche os dois
    // automaticamente pra manter os três sempre consistentes entre si.
    // Se a Disciplina mudou como consequência, recarrega a lista de questões
    // disponíveis (senão a busca continuaria filtrando pela Disciplina antiga).
    private async Task AoMudarTurmaAsync()
    {
        if (modelo.TurmaId == 0)
        {
            return;
        }

        var turma = todasTurmas.FirstOrDefault(t => t.Id == modelo.TurmaId);
        if (turma is null)
        {
            return;
        }

        // Igual ao <select> de Disciplina: se a Turma escolhida implica outra
        // Disciplina, isso vai limpar a seleção de questões — mesmo aviso de
        // confirmação, senão o professor pode perder a montagem sem querer só
        // por trocar de Turma. Desistindo, desfaz a própria Turma escolhida
        // (ela é a causa da troca), sem mexer em mais nada.
        if (modelo.DisciplinaId != turma.DisciplinaId && !await ConfirmarLimpezaSelecaoAsync())
        {
            modelo.TurmaId = 0;
            return;
        }

        modelo.CursoId = turma.CursoId;
        modelo.Ano = turma.Ano;
        modelo.Semestre = turma.Semestre;
        modelo.Bimestre = turma.Bimestre;

        if (modelo.DisciplinaId != turma.DisciplinaId)
        {
            modelo.DisciplinaId = turma.DisciplinaId;
            await CarregarQuestoesDisponiveisAsync();
        }

        // CarregarQuestoesDisponiveisAsync já chama isso quando a Disciplina
        // muda — mas Ano/Semestre/Bimestre também podem ter mudado aqui sem a
        // Disciplina mudar (turma diferente, mesma matéria), então chama de
        // novo pra cobrir esse caso (idempotente, sem problema chamar 2x).
        AtualizarSugestaoTitulo();
    }

    // Sem lógica própria — só existe pra servir de alvo de EventCallback de
    // QUALQUER componente filho "burro" que precise avisar ProvaForm de uma
    // mudança que não tem efeito colateral próprio (ao contrário de
    // AoMudarDisciplinaAsync etc., que recarregam dados). Invocá-lo força o
    // Blazor a rodar StateHasChanged em ProvaForm (dona desse método),
    // repropagando o valor mudado (ex.: Tempo estimado em DadosProva, Valor
    // da prova em PontuacaoProva) pra outros componentes irmãos que exibem
    // esse mesmo dado (ex.: o card Resumo da prova) e que, sozinhos, não
    // teriam motivo pra re-renderizar.
    private void NotificarMudanca()
    {
    }

    // Se o professor trocar o Curso manualmente e isso deixar a Turma já
    // escolhida inconsistente (turma de outro curso), desmarca a Turma em vez
    // de deixar os dois campos se contradizendo.
    private async Task AoMudarCurso()
    {
        if (modelo.TurmaId != 0)
        {
            var turma = todasTurmas.FirstOrDefault(t => t.Id == modelo.TurmaId);
            if (turma is not null && turma.CursoId != modelo.CursoId)
            {
                modelo.TurmaId = 0;
            }
        }

        // Trocar (ou limpar) o Curso invalida qualquer item de matriz já
        // marcado no gerador (eles são do curso ANTERIOR) — mesma lógica já
        // usada em QuestaoForm.razor pra não deixar filtro/seleção
        // inconsistente. Zera os dois modos (Filtro e Blueprint) e volta pra
        // SemMatriz — sem isso, um Blueprint configurado no curso anterior
        // ficaria "ativo" apontando pra itens que não existem mais aqui.
        gerador.ItemMatrizIdsDesejados.Clear();
        percPorItemGerador.Clear();
        gerador.ModoAlinhamentoCurricular = ModoAlinhamentoCurricular.SemMatriz;
        await CarregarItensDoCursoProvaAsync();

        AtualizarSugestaoTitulo();
    }

    private async Task CarregarItensDoCursoProvaAsync()
    {
        itensCurricularProva = modelo.CursoId == 0
            ? new()
            : await MatrizService.ListarItensVinculaveisPorCursoAsync(modelo.CursoId);
    }

    private void AplicarFiltro()
    {
        questoesFiltradas = filtroAssuntoId == 0
            ? questoesDisponiveis
            : questoesDisponiveis.Where(q => q.AssuntoId == filtroAssuntoId).ToList();
    }

    private void Adicionar(Questao q)
    {
        if (selecionadas.Any(s => s.QuestaoId == q.Id))
        {
            return;
        }
        questoesPorId[q.Id] = q;
        selecionadas.Add(new QuestaoSelecionada
        {
            QuestaoId = q.Id,
            Ordem = selecionadas.Count == 0 ? 0 : selecionadas.Max(s => s.Ordem) + 1,
        });
    }

    // Modal "Visualizar" (item 12) — a questão já está inteira em memória
    // (Alternativas/Pares/Lacunas incluídas por
    // ObterAssuntosEQuestoesDisponiveisAsync), então abrir o modal é só
    // trocar o ponteiro, sem ida ao banco.
    private void AbrirPreview(Questao q) => questaoPreview = q;

    private void FecharPreview() => questaoPreview = null;

    private void AdicionarDoPreview(Questao q)
    {
        Adicionar(q);
        FecharPreview();
    }

    // RenderizarEnunciadoPreview/RenderizarPreview/LetraDe/AlinhamentoCss
    // (helpers do modal "Visualizar") foram movidos pra dentro de
    // QuestaoPreviewModal.razor — só eram usados lá dentro.
    // DificuldadeEmoji foi movido pra dentro de BancoQuestoesSelector.razor —
    // só era usado lá.

    private void Remover(QuestaoSelecionada s) => selecionadas.Remove(s);

    // Reordenação por arrastar (item 13) — substitui os antigos botões ↑/↓.
    // "arrastando" guarda qual item começou o arrasto; ao soltar sobre outro
    // item, ele é removido da posição antiga e reinserido na posição do
    // alvo, e a Ordem de TODOS é renumerada sequencialmente (0..n-1) — mais
    // simples e sem risco de colisão do que tentar trocar só dois valores de
    // Ordem como Subir/Descer faziam.
    private QuestaoSelecionada? arrastando;

    private void IniciarArrasto(QuestaoSelecionada s) => arrastando = s;

    private void SoltarSobre(QuestaoSelecionada alvo)
    {
        if (arrastando is null || ReferenceEquals(arrastando, alvo))
        {
            arrastando = null;
            return;
        }

        var ordenadas = selecionadas.OrderBy(x => x.Ordem).ToList();
        ordenadas.Remove(arrastando);
        var indiceAlvo = ordenadas.IndexOf(alvo);
        ordenadas.Insert(indiceAlvo, arrastando);

        for (var i = 0; i < ordenadas.Count; i++)
        {
            ordenadas[i].Ordem = i;
        }

        arrastando = null;
    }

    private string? avisoSubstituicao;

    // "🔄 Substituir" (item 14): troca só essa questão por outra do banco com
    // o mesmo Assunto, Dificuldade e Bloom — preferindo o mesmo Tipo quando
    // existe candidata assim, mas aceitando outro tipo se não existir (regra
    // "mesmo tipo, se possível" do pedido). Nunca escolhe uma que já esteja
    // na prova. Reaproveita ProvaService.SortearAleatorios (mesma preferência
    // por questões menos usadas do gerador) pra escolher UMA substituta.
    private void Substituir(QuestaoSelecionada s)
    {
        avisoSubstituicao = null;
        var atual = questoesPorId[s.QuestaoId];

        var idsNaProva = selecionadas.Select(x => x.QuestaoId).ToHashSet();

        var candidatosBase = questoesDisponiveis
            .Where(q => !idsNaProva.Contains(q.Id))
            .Where(q => q.AssuntoId == atual.AssuntoId)
            .Where(q => q.Dificuldade == atual.Dificuldade)
            .Where(q => q.Bloom == atual.Bloom)
            .ToList();

        var candidatosMesmoTipo = candidatosBase.Where(q => q.TipoQuestao == atual.TipoQuestao).ToList();
        var candidatos = candidatosMesmoTipo.Count > 0 ? candidatosMesmoTipo : candidatosBase;

        if (candidatos.Count == 0)
        {
            avisoSubstituicao = $"Nenhuma questão equivalente disponível pra substituir \"{Truncar(atual.Enunciado)}\" (mesmo assunto, dificuldade e Bloom).";
            return;
        }

        var escolhida = ProvaService.SortearAleatorios(candidatos, 1, usosPorQuestaoDisponiveis).First();
        questoesPorId[escolhida.Id] = escolhida;
        s.QuestaoId = escolhida.Id;
    }

    // AbreviacaoTipo foi movido pra dentro de QuestoesSelecionadas.razor —
    // só era usado lá.

    // "Gerar prova" descarta o que já estava escolhido e monta um conjunto
    // novo do zero — é o que "sortear" normalmente significa pro professor.
    // "+ Adicionar questões pelo gerador" é o comportamento antigo (mantém o
    // que já tinha e só completa) — dois botões distintos pra não surpreender
    // quem clica de novo esperando um resultado diferente e acaba com o dobro
    // de questões.
    private Task GerarProvaAsync() => SortearQuestoesAsync(substituir: true);

    private Task AdicionarPeloGeradorAsync() => SortearQuestoesAsync(substituir: false);

    private async Task SortearQuestoesAsync(bool substituir)
    {
        avisoGerador = null;

        if (substituir)
        {
            selecionadas.Clear();
        }

        var idsAEvitar = gerador.EvitarRecentes
            ? await ProvaService.ObterIdsRecentesAsync(meuId, gerador.CriterioRecentes, gerador.ValorCriterioRecentes)
            : new HashSet<int>();

        // Farol de qualidade como filtro (item 6): restringe o pool de
        // candidatas ANTES de mandar pro sorteio, em vez de mexer em
        // ProvaService.Sortear — mais simples e mantém a função pura de
        // sempre só com mais uma lista de entrada já filtrada.
        var pool = PoolQualificado();

        SorteioResultado resultado;

        if (gerador.ModoAlinhamentoCurricular == ModoAlinhamentoCurricular.BlueprintCurricular)
        {
            // Modo Blueprint Curricular (item 2/3/4 do pedido): eixo de
            // alocação primário passa a ser o Item de Matriz, não mais
            // Assunto/Dificuldade/Bloom nem "Definir quantidade por tipo" —
            // ver o comentário de ProvaService.SortearPorBlueprintCurricular
            // pra essa simplificação documentada.
            var resultadoBlueprint = ProvaService.SortearPorBlueprintCurricular(
                pool,
                itensCurricularProva,
                percPorItemGerador,
                TiposPermitidosAtuais(),
                gerador.Quantidade,
                selecionadas.Select(s => s.QuestaoId).ToHashSet(),
                usosPorQuestaoDisponiveis,
                idsAEvitar);

            resultado = new SorteioResultado
            {
                Sorteadas = resultadoBlueprint.Sorteadas,
                Aviso = resultadoBlueprint.Aviso,
                Abortado = resultadoBlueprint.Abortado,
            };
        }
        else if (gerador.DefinirQuantidadePorTipo && quantidadePorTipoGerador.Count > 0)
        {
            // Uma chamada a Sortear por tipo, cada uma com sua própria cota —
            // TiposPermitidos vira uma lista de um item só nessa chamada, e o
            // resultado de uma alimenta IdsJaSelecionados da próxima (via
            // idsAcumulados), pra não haver repetição entre tipos.
            var sorteadasTotais = new List<Questao>();
            var idsAcumulados = new HashSet<int>(selecionadas.Select(s => s.QuestaoId));
            var avisos = new List<string>();
            var abortado = false;

            foreach (var (tipo, qtdTipo) in quantidadePorTipoGerador)
            {
                if (qtdTipo <= 0)
                {
                    continue;
                }

                var resultadoTipo = ProvaService.Sortear(pool, assuntosDisponiveis, new SorteioParametros
                {
                    PercPorAssunto = percPorAssuntoGerador,
                    TiposPermitidos = new List<TipoQuestao> { tipo },
                    PercPorBloom = percPorBloomGerador,
                    Quantidade = qtdTipo,
                    PercFacil = gerador.PercFacil,
                    PercMedia = gerador.PercMedia,
                    PercDificil = gerador.PercDificil,
                    IdsJaSelecionados = idsAcumulados,
                    UsosPorQuestao = usosPorQuestaoDisponiveis,
                }, idsAEvitar);

                if (resultadoTipo.Abortado)
                {
                    abortado = true;
                    avisos.Add($"{tipo.Rotulo()}: {resultadoTipo.Aviso}");
                    continue;
                }

                foreach (var q in resultadoTipo.Sorteadas)
                {
                    sorteadasTotais.Add(q);
                    idsAcumulados.Add(q.Id);
                }
                if (resultadoTipo.Aviso is not null)
                {
                    avisos.Add(resultadoTipo.Aviso);
                }
            }

            resultado = new SorteioResultado
            {
                Sorteadas = sorteadasTotais,
                Aviso = avisos.Count == 0 ? null : string.Join(" ", avisos),
                Abortado = abortado,
            };
        }
        else
        {
            resultado = ProvaService.Sortear(pool, assuntosDisponiveis, new SorteioParametros
            {
                PercPorAssunto = percPorAssuntoGerador,
                TiposPermitidos = TiposPermitidosAtuais(),
                PercPorBloom = percPorBloomGerador,
                Quantidade = gerador.Quantidade,
                PercFacil = gerador.PercFacil,
                PercMedia = gerador.PercMedia,
                PercDificil = gerador.PercDificil,
                IdsJaSelecionados = selecionadas.Select(s => s.QuestaoId).ToHashSet(),
                UsosPorQuestao = usosPorQuestaoDisponiveis,
            }, idsAEvitar);
        }

        foreach (var q in resultado.Sorteadas)
        {
            questoesPorId[q.Id] = q;
            selecionadas.Add(new QuestaoSelecionada
            {
                QuestaoId = q.Id,
                Ordem = selecionadas.Count == 0 ? 0 : selecionadas.Max(s => s.Ordem) + 1,
            });
        }

        if (gerador.ValorTotal is > 0 && selecionadas.Count > 0)
        {
            AplicarDistribuicaoValor(gerador.ValorTotal.Value);
        }

        avisoGerador = resultado.Aviso;
    }

    // Botão "Aplicar" do bloco Pontuação (item 16) — valida e delega pro modo
    // escolhido. Modo Manual não tem o que aplicar (o professor edita cada
    // Valor na lista acima), então nem chega a chamar distribuição nenhuma.
    private void AplicarPontuacao()
    {
        avisoPontuacao = null;

        if (modoPontuacao == ModoPontuacao.Manual)
        {
            return;
        }

        if (selecionadas.Count == 0)
        {
            avisoPontuacao = "Adicione questões antes de distribuir o valor.";
            return;
        }

        if (gerador.ValorTotal is null or <= 0)
        {
            avisoPontuacao = "Informe o valor da prova.";
            return;
        }

        AplicarDistribuicaoValor(gerador.ValorTotal.Value);
    }

    // Ponto único que decide COMO distribuir o valor, de acordo com o modo de
    // Pontuação escolhido — usado tanto pelo botão "Aplicar" quanto
    // automaticamente ao gerar/adicionar via o gerador (SortearQuestoesAsync),
    // pra os dois caminhos nunca divergirem sobre qual regra vale.
    private void AplicarDistribuicaoValor(decimal valorTotal)
    {
        switch (modoPontuacao)
        {
            case ModoPontuacao.ProporcionalDificuldade:
                DistribuirValorProporcionalDificuldade(valorTotal);
                break;
            case ModoPontuacao.Manual:
                // Nada a fazer — distribuição automática desligada de propósito.
                break;
            default:
                DistribuirValorEntreSelecionadas(valorTotal);
                break;
        }
    }

    // Peso por Dificuldade pro modo "proporcional" — valores fixos (não
    // configuráveis ainda) só pra dar uma opção melhor que "todo mundo igual"
    // sem abrir uma tela de configuração à parte. Difícil vale o dobro de
    // Fácil, Média fica no meio — arbitrário mas razoável como padrão.
    private static readonly Dictionary<Dificuldade, decimal> pesosDificuldadePontuacao = new()
    {
        [Dificuldade.Facil] = 1m,
        [Dificuldade.Media] = 1.5m,
        [Dificuldade.Dificil] = 2m,
    };

    // Mesma ideia de DistribuirValorEntreSelecionadas (última absorve o resto
    // do arredondamento), mas cada questão recebe valorPorPeso * seu próprio
    // peso de Dificuldade, em vez de uma fatia igual pra todo mundo.
    private void DistribuirValorProporcionalDificuldade(decimal valorTotal)
    {
        if (selecionadas.Count == 0)
        {
            return;
        }

        var ordenadas = selecionadas.OrderBy(s => s.Ordem).ToList();
        var pesoTotal = ordenadas.Sum(s => pesosDificuldadePontuacao.GetValueOrDefault(questoesPorId[s.QuestaoId].Dificuldade, 1m));
        if (pesoTotal <= 0)
        {
            return;
        }

        var valorPorPeso = valorTotal / pesoTotal;
        var restante = valorTotal;
        for (var i = 0; i < ordenadas.Count; i++)
        {
            var peso = pesosDificuldadePontuacao.GetValueOrDefault(questoesPorId[ordenadas[i].QuestaoId].Dificuldade, 1m);
            var valor = i == ordenadas.Count - 1 ? restante : Math.Round(valorPorPeso * peso, 2);
            ordenadas[i].Valor = valor;
            restante -= valor;
        }
    }

    // Divide o valor total igualmente entre as questões selecionadas. A última
    // questão absorve o resto do arredondamento, pra soma bater certinho com o total.
    // Sempre editável depois — isso só preenche um valor inicial, não trava nada.
    private void DistribuirValorEntreSelecionadas(decimal valorTotal)
    {
        if (selecionadas.Count == 0)
        {
            return;
        }

        var valorPorQuestao = Math.Round(valorTotal / selecionadas.Count, 2);
        var restante = valorTotal;
        for (var i = 0; i < selecionadas.Count; i++)
        {
            var valor = i == selecionadas.Count - 1 ? restante : valorPorQuestao;
            selecionadas[i].Valor = valor;
            restante -= valor;
        }
    }

    private static string Truncar(string texto) => texto.Length > 70 ? texto[..70] + "..." : texto;

    private async Task SalvarAsync()
    {
        erro = null;

        try
        {
            if (Id is null)
            {
                await ProvaService.CriarAsync(modelo, selecionadas, meuId);
            }
            else
            {
                await ProvaService.AtualizarAsync(Id.Value, modelo, selecionadas, meuId);
            }

            NavigationManager.NavigateTo($"provas?msg={Uri.EscapeDataString($"\"{modelo.Titulo}\" salva com sucesso.")}");
        }
        catch (OperacaoInvalidaException ex)
        {
            erro = ex.Message;
        }
    }
}
