@page "/aplicacoes-prova"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AplicacaoProvaService AplicacaoProvaService
@inject IJSRuntime JS

<PageTitle>Provas Online</PageTitle>

<PageHeader Titulo="Provas Online" Subtitulo="Aplicações de provas pra os alunos responderem online, com correção automática.">
    <Acao>
        <a class="btn btn-primary" href="aplicacoes-prova/novo">+ Aplicar prova online</a>
    </Acao>
</PageHeader>

@if (sucesso is not null)
{
    <div class="alert alert-success">@sucesso</div>
}

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}

@if (aplicacoes is null)
{
    <p><em>Carregando...</em></p>
}
else if (aplicacoes.Count == 0)
{
    <p><em>Nenhuma prova aplicada online ainda.</em></p>
}
else
{
    <p class="text-muted small">
        Mostrando @((pagina - 1) * TamanhoPagina + 1)–@((pagina - 1) * TamanhoPagina + aplicacoes.Count) de @totalRegistros aplicação(ões).
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>Prova</th>
                <th>Turma</th>
                <th>Código</th>
                <th>Status</th>
                <th>Prazo</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in aplicacoes)
            {
                <tr>
                    <td>@a.Prova?.Titulo</td>
                    <td>@a.Turma?.Rotulo</td>
                    <td><code>@a.CodigoAcesso</code></td>
                    <td>
                        @if (a.Status == StatusAplicacaoProva.Aberta)
                        {
                            <span class="badge bg-success">Aberta</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Encerrada</span>
                        }
                    </td>
                    <td>@(a.DataLimite is { } d ? d.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")</td>
                    <td>
                        <a class="btn btn-sm btn-secondary" href="@($"aplicacoes-prova/{a.Id}")">Resultados</a>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => AlternarStatusAsync(a)">
                            @(a.Status == StatusAplicacaoProva.Aberta ? "Encerrar" : "Reabrir")
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarExcluirAsync(a)">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Paginacao Pagina="pagina" TamanhoPagina="TamanhoPagina" TotalRegistros="totalRegistros" PaginaChanged="MudarPaginaAsync" />
}

@code {
    private List<AplicacaoProva>? aplicacoes;
    private string? erro;
    private string? sucesso;

    private const int TamanhoPagina = 20;
    private int pagina = 1;
    private int totalRegistros;

    [SupplyParameterFromQuery(Name = "msg")]
    private string? Msg { get; set; }

    protected override async Task OnInitializedAsync()
    {
        sucesso = Msg;
        await CarregarAsync();
    }

    private async Task MudarPaginaAsync(int novaPagina)
    {
        pagina = novaPagina;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        var resultado = await AplicacaoProvaService.ListarAsync(filtroProvaId: 0, filtroTurmaId: 0, pagina, TamanhoPagina);
        aplicacoes = resultado.Itens;
        totalRegistros = resultado.Total;
    }

    private async Task AlternarStatusAsync(AplicacaoProva a)
    {
        erro = null;
        sucesso = null;
        await AplicacaoProvaService.AlternarStatusAsync(a);
        sucesso = a.Status == StatusAplicacaoProva.Aberta ? "Aplicação reaberta." : "Aplicação encerrada.";
    }

    private async Task ConfirmarExcluirAsync(AplicacaoProva a)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Excluir a aplicação de \"{a.Prova?.Titulo}\" na turma \"{a.Turma?.Rotulo}\"? Essa ação não pode ser desfeita.");
        if (confirmado)
        {
            erro = null;
            sucesso = null;
            try
            {
                await AplicacaoProvaService.ExcluirAsync(a);
                sucesso = "Aplicação excluída com sucesso.";
                await CarregarAsync();
            }
            catch (OperacaoInvalidaException ex)
            {
                erro = ex.Message;
            }
        }
    }
}
