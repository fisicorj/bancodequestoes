@page "/cursos/novo"
@page "/cursos/editar/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CursoService CursoService
@inject InstituicaoService InstituicaoService
@inject AreaCursoService AreaCursoService
@inject MatrizReferenciaService MatrizService
@inject DisciplinaService DisciplinaService
@inject NavigationManager NavigationManager

<PageTitle>@(Id is null ? "Novo curso" : "Editar curso")</PageTitle>

<PageHeader Titulo="@(Id is null ? "Novo curso" : "Editar curso")" />

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}

@if (carregando)
{
    <p><em>Carregando...</em></p>
}
else if (instituicoes.Count == 0)
{
    <p><em>Cadastre uma instituição antes de criar um curso.</em> <a href="instituicoes/novo">Criar instituição</a></p>
}
else
{
    <div class="row">
        <div class="col-md-5">
            <div class="form-card">
                <EditForm Model="modelo" OnValidSubmit="SalvarAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="form-floating mb-3">
                        <InputText @bind-Value="modelo.Nome" id="Nome" class="form-control" placeholder="Nome" />
                        <label for="Nome">Nome</label>
                    </div>

                    <div class="form-floating mb-3">
                        <InputSelect @bind-Value="modelo.InstituicaoId" id="InstituicaoId" class="form-select">
                            <option value="0">Selecione...</option>
                            @foreach (var i in instituicoes)
                            {
                                <option value="@i.Id">@i.Nome</option>
                            }
                        </InputSelect>
                        <label for="InstituicaoId">Instituição</label>
                    </div>

                    <div class="form-floating mb-3">
                        <InputSelect @bind-Value="modelo.AreaCursoId" id="AreaCursoId" class="form-select">
                            <option value="">Nenhuma / não definida</option>
                            @foreach (var a in areasCurso)
                            {
                                <option value="@a.Id">@a.Nome</option>
                            }
                        </InputSelect>
                        <label for="AreaCursoId">Área de Curso (ENADE/DCN)</label>
                    </div>
                    <p class="form-text text-muted mt-n2 mb-3">
                        Opcional. Define qual Área de Curso nacional (ex.: "Engenharia de Computação") este curso
                        representa — é o que faz matrizes ENADE/DCN cadastradas pra essa área aparecerem
                        automaticamente aqui, compartilhadas com outras instituições que usam a mesma área.
                        <a href="areas-curso">Gerenciar áreas de curso</a>.
                    </p>

                    <button type="submit" class="btn btn-primary">Salvar</button>
                    <a href="cursos" class="btn btn-link">Cancelar</a>
                </EditForm>
            </div>
        </div>
    </div>

    @if (Id is not null)
    {
        <div class="row mt-4">
            <div class="col-md-7">
                <h5>Matrizes de Referência</h5>
                @if (matrizesDoCurso.Count == 0)
                {
                    <p class="text-muted"><em>Nenhuma matriz de referência cadastrada para esse curso ainda.</em></p>
                }
                else
                {
                    <ul class="list-group mb-2">
                        @foreach (var m in matrizesDoCurso)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    @m.Nome
                                    @if (!string.IsNullOrWhiteSpace(m.Orgao))
                                    {
                                        <span class="text-muted small">(@m.Orgao)</span>
                                    }
                                    <span class="badge text-bg-@m.Status.CorBadge()">@m.Status.Rotulo()</span>
                                </span>
                                <a class="btn btn-sm btn-outline-primary" href="@($"matrizes/{m.Id}/itens")">Gerenciar</a>
                            </li>
                        }
                    </ul>
                }
                <a class="btn btn-sm btn-primary" href="@($"matrizes/novo?cursoId={Id}")">+ Nova Matriz</a>
                <a class="btn btn-sm btn-link" href="@($"matrizes/{Id}")">Ver todas</a>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-7">
                <h5>Grade Curricular (Curso ↔ Disciplina)</h5>
                <p class="text-muted small">
                    Quais Disciplinas fazem parte da grade deste curso — preenchido automaticamente ao criar uma
                    Turma, mas também pode ser cadastrado aqui antes de existir qualquer Turma (ex.: planejamento
                    de um semestre futuro).
                </p>

                @if (erroGrade is not null)
                {
                    <div class="alert alert-danger">@erroGrade</div>
                }

                @if (disciplinasDoCurso.Count == 0)
                {
                    <p class="text-muted"><em>Nenhuma disciplina na grade deste curso ainda.</em></p>
                }
                else
                {
                    <ul class="list-group mb-2">
                        @foreach (var v in disciplinasDoCurso)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    @v.Disciplina?.Nome
                                    @if (v.Semestre is not null)
                                    {
                                        <span class="text-muted small"> — @(v.Semestre)º semestre</span>
                                    }
                                    @if (v.CargaHoraria is not null)
                                    {
                                        <span class="text-muted small"> — @(v.CargaHoraria)h</span>
                                    }
                                    @if (!v.Ativa)
                                    {
                                        <span class="badge text-bg-secondary ms-1">Inativa</span>
                                    }
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ExcluirVinculoAsync(v)">Excluir</button>
                            </li>
                        }
                    </ul>
                }

                <div class="row g-2 align-items-end">
                    <div class="col-5">
                        <label class="form-label small mb-1">Disciplina</label>
                        <select class="form-select" @bind="novoVinculo.DisciplinaId">
                            <option value="0">Selecione...</option>
                            @foreach (var d in DisciplinasDisponiveisParaAdicionar)
                            {
                                <option value="@d.Id">@d.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="col-3">
                        <label class="form-label small mb-1">Semestre</label>
                        <input type="number" class="form-control" @bind="novoVinculo.Semestre" min="1" />
                    </div>
                    <div class="col-3">
                        <label class="form-label small mb-1">Carga horária</label>
                        <input type="number" class="form-control" @bind="novoVinculo.CargaHoraria" min="0" />
                    </div>
                    <div class="col-1">
                        <button type="button" class="btn btn-primary" @onclick="AdicionarVinculoAsync">+</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private CursoInput modelo = new();
    private List<Instituicao> instituicoes = new();
    private List<AreaCurso> areasCurso = new();
    private List<MatrizReferencia> matrizesDoCurso = new();
    private bool carregando;
    private string? erro;

    // Grade curricular (CursoDisciplina): disciplinasDoCurso é o vínculo atual,
    // todasDisciplinas alimenta o <select> de adicionar, novoVinculo é o mini-form inline.
    private List<CursoDisciplina> disciplinasDoCurso = new();
    private List<Disciplina> todasDisciplinas = new();
    private CursoDisciplinaInput novoVinculo = new();
    private string? erroGrade;

    // UX apenas: esconde disciplinas já vinculadas do <select> (a validação
    // real contra duplicata continua no backend).
    private IEnumerable<Disciplina> DisciplinasDisponiveisParaAdicionar =>
        todasDisciplinas.Where(d => disciplinasDoCurso.All(v => v.DisciplinaId != d.Id));

    protected override async Task OnInitializedAsync()
    {
        carregando = true;
        instituicoes = await InstituicaoService.ListarTodasAsync();
        areasCurso = await AreaCursoService.ListarAtivasAsync();
        todasDisciplinas = await DisciplinaService.ListarTodasAsync();

        if (Id is not null)
        {
            var curso = await CursoService.ObterAsync(Id.Value);
            if (curso is null)
            {
                erro = "Curso não encontrado.";
            }
            else
            {
                modelo = new CursoInput { Nome = curso.Nome, InstituicaoId = curso.InstituicaoId, AreaCursoId = curso.AreaCursoId };
                matrizesDoCurso = await MatrizService.ListarPorCursoAsync(Id.Value);
                disciplinasDoCurso = await CursoService.ListarDisciplinasDoCursoAsync(Id.Value);
            }
        }
        carregando = false;
    }

    private async Task AdicionarVinculoAsync()
    {
        erroGrade = null;

        if (Id is null)
        {
            return;
        }

        try
        {
            novoVinculo.CursoId = Id.Value;
            await CursoService.CriarCursoDisciplinaAsync(novoVinculo);
            disciplinasDoCurso = await CursoService.ListarDisciplinasDoCursoAsync(Id.Value);
            novoVinculo = new CursoDisciplinaInput();
        }
        catch (OperacaoInvalidaException ex)
        {
            erroGrade = ex.Message;
        }
    }

    private async Task ExcluirVinculoAsync(CursoDisciplina vinculo)
    {
        erroGrade = null;

        try
        {
            await CursoService.ExcluirCursoDisciplinaAsync(vinculo);
            disciplinasDoCurso = await CursoService.ListarDisciplinasDoCursoAsync(Id!.Value);
        }
        catch (OperacaoInvalidaException ex)
        {
            erroGrade = ex.Message;
        }
    }

    private async Task SalvarAsync()
    {
        erro = null;

        try
        {
            if (Id is null)
            {
                await CursoService.CriarAsync(modelo);
            }
            else
            {
                await CursoService.AtualizarAsync(Id.Value, modelo);
            }

            NavigationManager.NavigateTo($"cursos?msg={Uri.EscapeDataString($"\"{modelo.Nome}\" salvo com sucesso.")}");
        }
        catch (OperacaoInvalidaException ex)
        {
            erro = ex.Message;
        }
    }
}
